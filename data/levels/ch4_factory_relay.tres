[gd_resource type="Resource" script_class="LevelData" load_steps=12 format=3]

[ext_resource type="Script" path="res://data/scripts/level_data.gd" id="1_level_data"]
[ext_resource type="Resource" path="res://data/enemies/slasher.tres" id="2_slasher"]
[ext_resource type="Resource" path="res://data/enemies/searchlight_drone.tres" id="3_searchlight_drone"]
[ext_resource type="Resource" path="res://data/enemies/sweeper.tres" id="4_sweeper"]
[ext_resource type="Script" path="res://data/scripts/portal_data.gd" id="5_portal_data"]
[ext_resource type="Script" path="res://data/scripts/lighting_zone.gd" id="6_lighting_zone"]
[ext_resource type="Resource" path="res://data/lighting/ch4_loading_bay.tres" id="7_ch4_loading_bay"]
[ext_resource type="Resource" path="res://data/environment/themes/ch4_factory_relay.tres" id="8_ch4_factory_relay"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("5_portal_data")
id = &"relay_loading"
target_level = "res://data/levels/ch4_factory_loading.tres"
target_portal = &"loading_relay"
prompt = "{interact} 回舊廠裝卸帶"
localized_prompts = Dictionary[String, String]({"en": "{interact} Return to the loading bay", "ja": "{interact} 荷さばき場へ戻る"})
width = 32
height = 68
style = "door"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("5_portal_data")
id = &"relay_safe"
target_level = "res://data/levels/ch4_factory_safety.tres"
target_portal = &"safety_relay"
prompt = "{interact} 進安全臺"
localized_prompts = Dictionary[String, String]({"en": "{interact} Enter the safe platform", "ja": "{interact} 安全台に入る"})
width = 32
height = 68
style = "door"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("6_lighting_zone")
start_tile = 0
blend_tiles = 12
profile = ExtResource("7_ch4_loading_bay")

[resource]
script = ExtResource("1_level_data")
id = &"ch4_factory_relay"
display_name = "廠房接線廊"
localized_names = Dictionary[String, String]({"en": "Factory Service Walk", "ja": "工場の配線通路"})
tile_size = 16
height = 24
legend = Dictionary[String, Resource]({
"b": ExtResource("2_slasher"),
"d": ExtResource("3_searchlight_drone"),
"g": ExtResource("4_sweeper"),
"Ⅿ": SubResource("Resource_0"),
"↟": SubResource("Resource_1")
})
hints = PackedStringArray()
chapter = &"ch4_hollow"
persistent_world = true
show_chapter_card = false
environment = ExtResource("8_ch4_factory_relay")
layout_path = "res://data/levels/ch4_factory_relay_map.json"
lighting_zones = Array[ExtResource("6_lighting_zone")]([SubResource("Resource_2")])
story_triggers = PackedStringArray()
death_credit_cap = 250

[ext_resource type="Resource" path="res://data/props/ch4_upper_sweep.tres" id="5_ch4_upper_sweep"]
[ext_resource type="Resource" path="res://data/props/ch4_lower_sweep.tres" id="6_ch4_lower_sweep"]

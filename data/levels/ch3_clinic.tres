[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("3_portal_data")
id = &"clinic_mezz"
target_level = "res://data/levels/ch3_mezzanine.tres"
target_portal = &"mezz_clinic"
prompt = "{interact} 回夾層通道"
localized_prompts = Dictionary[String, String]({"en": "{interact} Return to the mezzanine passage", "ja": "{interact} 中二階の通路へ戻る"})
style = "door"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("3_portal_data")
id = &"clinic_gate"
target_level = "res://data/levels/ch3_gate_hall.tres"
target_portal = &"gate_clinic"
requires_flag = &"ch3_report_reconciled"
locked_text = "門禁大廳要夾層證。先在閱覽桌把三份公開資料核對完。"
localized_locked_text = Dictionary[String, String]({"en": "Check the three public records at the reading desk for a mezzanine pass.", "ja": "閲覧机で三つの公開資料を照合し、中二階の通行証を取る。"})
prompt = "{interact} 往門禁大廳"
localized_prompts = Dictionary[String, String]({"en": "{interact} Go to the Access Hall", "ja": "{interact} 入退館ホールへ"})
style = "door"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("12_lighting_zone")
start_tile = 0
blend_tiles = 12
profile = ExtResource("13_clinic_ward")

[resource]
script = ExtResource("1_level_data")
id = &"ch3_clinic"
display_name = "夾層診所"
localized_names = Dictionary[String, String]({"en": "Mezzanine Clinic", "ja": "中二階の診療所"})
tile_size = 16
height = 24
legend = Dictionary[String, Resource]({
"X": ExtResource("2_ch1_secret_wall"),
"m": SubResource("Resource_0"),
"q": ExtResource("4_credits_large"),
"ⅰ": SubResource("Resource_1"),
"Ⓞ": ExtResource("5_ch3_register_cabinet"),
"Ⓩ": ExtResource("6_ch3_clinic_cups"),
"ⓓ": ExtResource("7_ch3_deposit_drawer"),
"ⓔ": ExtResource("8_ch3_reading_desk"),
"ⓟ": ExtResource("9_ch3_public_report"),
"ⓣ": ExtResource("10_ch3_nursing_board"),
"ⓩ": ExtResource("11_ch3_zhi")
})
hints = PackedStringArray()
chapter = &"ch3_clearwater"
persistent_world = true
show_chapter_card = false
environment = ExtResource("14_ch3_clinic")
layout_path = "res://data/levels/ch3_clinic_map.json"
lighting_zones = Array[ExtResource("12_lighting_zone")]([SubResource("Resource_2")])
story_triggers = PackedStringArray()
death_credit_cap = 250

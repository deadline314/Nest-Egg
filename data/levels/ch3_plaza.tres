[gd_resource type="Resource" script_class="LevelData" load_steps=18 format=3]

[ext_resource type="Script" path="res://data/scripts/level_data.gd" id="1_level_data"]
[ext_resource type="Script" path="res://data/scripts/portal_data.gd" id="2_portal_data"]
[ext_resource type="Resource" path="res://data/props/credits_small.tres" id="3_credits_small"]
[ext_resource type="Resource" path="res://data/props/credits_maintenance.tres" id="4_credits_maintenance"]
[ext_resource type="Resource" path="res://data/npcs/ch3_control_box.tres" id="5_ch3_control_box"]
[ext_resource type="Resource" path="res://data/npcs/ch3_water_gauge.tres" id="6_ch3_water_gauge"]
[ext_resource type="Resource" path="res://data/npcs/ch3_plaza_nurse.tres" id="7_ch3_plaza_nurse"]
[ext_resource type="Resource" path="res://data/npcs/ch3_plaza_notice.tres" id="8_ch3_plaza_notice"]
[ext_resource type="Resource" path="res://data/npcs/ch3_outer_ladder.tres" id="9_ch3_outer_ladder"]
[ext_resource type="Script" path="res://data/scripts/lighting_zone.gd" id="10_lighting_zone"]
[ext_resource type="Resource" path="res://data/lighting/plaza.tres" id="11_plaza"]
[ext_resource type="Resource" path="res://data/environment/themes/ch3_plaza.tres" id="12_ch3_plaza"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("2_portal_data")
id = &"plaza_lift"
target_level = "res://data/levels/ch3_mezzanine.tres"
target_portal = &"mezz_lift"
requires_flag = &"ch3_freight_ready"
locked_text = "貨梯的安全聯鎖還沒解除。先到泵室把水排掉，再回控制箱叫車廂。"
localized_locked_text = Dictionary[String, String]({"en": "Drain the pump room, then call the freight lift from the control box.", "ja": "ポンプ室を排水し、操作盤から貨物リフトを呼ぶ。"})
prompt = "{interact} 搭貨梯上夾層"
localized_prompts = Dictionary[String, String]({"en": "{interact} Take the freight lift up to the mezzanine", "ja": "{interact} 貨物リフトで中二階へ上がる"})
width = 32
height = 56
style = "hidden"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_portal_data")
id = &"plaza_street"
target_level = "res://data/levels/ch3_pawnshop.tres"
target_portal = &"pawn_front"
prompt = "{interact} 回當舖"
localized_prompts = Dictionary[String, String]({"en": "{interact} Return to the pawnshop", "ja": "{interact} 質屋へ戻る"})
style = "door"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_portal_data")
id = &"plaza_pump"
target_level = "res://data/levels/ch3_pump.tres"
target_portal = &"pump_plaza"
prompt = "{interact} 走下路到泵室"
localized_prompts = Dictionary[String, String]({"en": "{interact} Take the lower path to the pump room", "ja": "{interact} 下の通路でポンプ室へ"})
width = 28
height = 44
style = "road"

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("2_portal_data")
id = &"plaza_ladder"
target_level = "res://data/levels/ch3_pump.tres"
target_portal = &"pump_ladder"
requires_flag = &"ch3_outer_ladder_down"
locked_text = "外梯還收著，貨梯接通以後才能從這一側放下來。"
localized_locked_text = Dictionary[String, String]({"en": "Restore freight lift power to lower the outside ladder from here.", "ja": "貨物リフトの電源を戻せば、ここから外はしごを下ろせる。"})
prompt = "{interact} 走外梯到泵室上橋"
localized_prompts = Dictionary[String, String]({"en": "{interact} Take the outside ladder to the pump room bridge", "ja": "{interact} 外はしごでポンプ室の上の橋へ"})
width = 24
height = 56
style = "hidden"

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("10_lighting_zone")
start_tile = 0
blend_tiles = 12
profile = ExtResource("11_plaza")

[resource]
script = ExtResource("1_level_data")
id = &"ch3_plaza"
display_name = "廣場貨梯"
localized_names = Dictionary[String, String]({"en": "Plaza Freight Lift", "ja": "広場の貨物リフト"})
tile_size = 16
height = 40
legend = Dictionary[String, Resource]({
"L": SubResource("Resource_0"),
"c": ExtResource("3_credits_small"),
"h": SubResource("Resource_1"),
"¢": ExtResource("4_credits_maintenance"),
"Ⅰ": SubResource("Resource_2"),
"Ⅴ": SubResource("Resource_3"),
"Ⓗ": ExtResource("5_ch3_control_box"),
"Ⓘ": ExtResource("6_ch3_water_gauge"),
"Ⓝ": ExtResource("7_ch3_plaza_nurse"),
"Ⓧ": ExtResource("8_ch3_plaza_notice"),
"ⓢ": ExtResource("9_ch3_outer_ladder")
})
hints = PackedStringArray("維修盒：水位降到低線後再領。", "沿纜輪維修道往上走，看得到貨梯、外梯和泵室的入口。")
chapter = &"ch3_clearwater"
persistent_world = true
show_chapter_card = false
environment = ExtResource("12_ch3_plaza")
layout_path = "res://data/levels/ch3_plaza_map.json"
lighting_zones = Array[ExtResource("10_lighting_zone")]([SubResource("Resource_4")])
story_triggers = PackedStringArray()
death_credit_cap = 250

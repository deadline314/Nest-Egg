[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("3_portal_data")
id = &"loading_market"
target_level = "res://data/levels/ch2_market.tres"
target_portal = &"market_cargo"
prompt = "{interact} 回公眾攤道"
localized_prompts = Dictionary[String, String]({"en": "{interact} Return to the Public Market Walk", "ja": "{interact} 公設市場通りへ戻る"})
width = 28
height = 44
style = "road"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("3_portal_data")
id = &"loading_sc1"
target_level = "res://data/levels/ch2_market.tres"
target_portal = &"market_sc1"
requires_flag = &"ch2_sc1_open"
locked_text = "橋梯還收著，旁邊的拉桿可以放下來。"
localized_locked_text = Dictionary[String, String]({"en": "Use the nearby lever to lower the bridge ladder.", "ja": "そばのレバーで橋のはしごを下ろせる。"})
prompt = "{interact} 走橋梯回代收處"
localized_prompts = Dictionary[String, String]({"en": "{interact} Take the bridge ladder back to the collection desk", "ja": "{interact} 橋のはしごで集金所へ戻る"})
width = 32
height = 56
style = "hidden"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("3_portal_data")
id = &"loading_ledger"
target_level = "res://data/levels/ch2_ledger_front.tres"
target_portal = &"front_loading"
requires_flag = &"ch2_market_reconciled"
locked_text = "貨門要核對過的卸貨批號，先在作業桌把三張紙對完。"
localized_locked_text = Dictionary[String, String]({"en": "Match the three papers at the worktable to verify the freight batch.", "ja": "作業台で三枚の用紙を照合し、荷降ろしのロット番号を確認する。"})
prompt = "{interact} 進北棟貨門"
localized_prompts = Dictionary[String, String]({"en": "{interact} Enter through the north building freight door", "ja": "{interact} 北棟の搬入扉から入る"})
width = 28
height = 56
style = "door"

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("3_portal_data")
id = &"loading_canopy"
target_level = "res://data/levels/ch2_market.tres"
target_portal = &"market_canopy"
requires_flag = &"ch2_market_contact_done"
locked_text = "先到代收處問清楚這筆代收款，再去後面查帳。"
localized_locked_text = Dictionary[String, String]({"en": "Ask the collection desk about the payment before checking the accounts.", "ja": "帳簿を調べる前に、集金所でこの支払いについて聞く。"})
prompt = "{interact} 沿雨棚回公眾攤道上層"
localized_prompts = Dictionary[String, String]({"en": "{interact} Cross the canopy back to the upper market walk", "ja": "{interact} 雨よけ伝いに公設市場通りの上層へ戻る"})
width = 28
height = 44
style = "road"

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("10_lighting_zone")
start_tile = 0
blend_tiles = 12
profile = ExtResource("11_market")

[sub_resource type="Resource" id="Resource_5"]
script = ExtResource("10_lighting_zone")
start_tile = 104
blend_tiles = 6
profile = ExtResource("12_hangar")

[resource]
script = ExtResource("1_level_data")
shootable_lamps = true
id = &"ch2_loading"
display_name = "雨棚背面與裝卸間"
localized_names = Dictionary[String, String]({"en": "Canopy and Loading Room", "ja": "雨よけの裏と荷さばき室"})
tile_size = 16
height = 40
legend = Dictionary[String, Resource]({
"!": ExtResource("94_suspended_crate"),
"c": ExtResource("2_credits_small"),
"Ⅹ": SubResource("Resource_0"),
"Ⅺ": SubResource("Resource_1"),
"Ⅻ": SubResource("Resource_2"),
"⇤": SubResource("Resource_3"),
"ⓓ": ExtResource("4_ch2_drying_desk"),
"ⓙ": ExtResource("5_ch2_sc1_lever"),
"ⓛ": ExtResource("6_ch2_collection_book"),
"ⓧ": ExtResource("7_ch2_guard"),
"⦀": ExtResource("97_hiding_spot"),
"♜": ExtResource("8_ch2_bill_thrower"),
"♞": ExtResource("9_ch2_escort")
})
hints = PackedStringArray()
chapter = &"ch2_heron"
persistent_world = true
show_chapter_card = false
environment = ExtResource("13_ch2_loading")
layout_path = "res://data/levels/ch2_loading_map.json"
lighting_zones = Array[ExtResource("10_lighting_zone")]([SubResource("Resource_4"), SubResource("Resource_5")])
story_triggers = PackedStringArray("ch2_s09_wire", "ch2_s09_hawker")
death_credit_cap = 250
challenges = Array[ExtResource("95_challenge_script")]([ExtResource("96_challenge")])

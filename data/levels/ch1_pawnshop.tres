[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("2_portal_data")
id = &"pawn_front"
target_level = "res://data/levels/ch1_street.tres"
target_portal = &"street_home"
requires_flag = &"ch1_heard_brief"
locked_text = "先去屋頂：鷺在等你。"
localized_locked_text = Dictionary[String, String]({"en": "Egret is waiting on the rooftop.", "ja": "鷺が屋上で待っている。"})
prompt = "{interact} 出門"
localized_prompts = Dictionary[String, String]({"en": "{interact} Go outside", "ja": "{interact} 外に出る"})
style = "door"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_portal_data")
id = &"pawn_basement"
locked_text = "地下室正在漏水，請別開門。"
localized_locked_text = Dictionary[String, String]({"en": "The basement is leaking. Keep the door shut.", "ja": "地下室が水漏れ中です。扉は開けないでください。"})
prompt = "{interact} 地下室"
localized_prompts = Dictionary[String, String]({"en": "{interact} Basement", "ja": "{interact} 地下室"})
width = 32
height = 48
style = "hidden"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_portal_data")
id = &"pawn_stairs"
target_level = "res://data/levels/ch1_rooftop.tres"
target_portal = &"roof_stairs"
requires_flag = &"ch1_dinner_done"
locked_text = "先吃晚飯。老 K 在等。"
localized_locked_text = Dictionary[String, String]({"en": "Old K is waiting for you to have supper.", "ja": "老Kが夕食を用意して待っている。"})
prompt = "{interact} 上屋頂"
localized_prompts = Dictionary[String, String]({"en": "{interact} Go to the rooftop", "ja": "{interact} 屋上へ上がる"})
width = 20
height = 152
style = "ladder"

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("15_lighting_zone")
start_tile = 0
blend_tiles = 12
profile = ExtResource("16_rooftop")

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("15_lighting_zone")
start_tile = 30
blend_tiles = 6
profile = ExtResource("17_pawnshop_warm")

[resource]
script = ExtResource("1_level_data")
id = &"ch1_pawnshop"
display_name = "當舖"
localized_names = Dictionary[String, String]({"en": "Pawnshop", "ja": "質屋"})
tile_size = 16
height = 24
legend = Dictionary[String, Resource]({
"F": SubResource("Resource_0"),
"K": SubResource("Resource_1"),
"S": SubResource("Resource_2"),
"V": ExtResource("3_ch1_pawn"),
"c": ExtResource("4_credits_small"),
"n": ExtResource("5_ch1_old_k"),
"t": ExtResource("6_doc_pawn_stub"),
"u": ExtResource("7_melee_dagger"),
"x": ExtResource("8_ch1_crate"),
"⒧": ExtResource("9_ch1_ledger_box"),
"⒰": ExtResource("10_ch1_umbrella_stand"),
"ⓕ": ExtResource("11_ch1_label_fare"),
"ⓖ": ExtResource("12_ch1_label_guitar"),
"ⓡ": ExtResource("13_ch1_label_raincoat"),
"ⓦ": ExtResource("14_ch1_label_watch")
})
hints = PackedStringArray("按 {inventory} 打開背包，武器改裝、道具與文件都在裡面。", "換彈按 {reload}；從單向平台落下要按住 {move_down} 再按 {jump}。")
chapter = &"ch1_kasa"
persistent_world = true
show_chapter_card = true
environment = ExtResource("18_ch1_pawnshop")
layout_path = "res://data/levels/ch1_pawnshop_map.json"
lighting_zones = Array[ExtResource("15_lighting_zone")]([SubResource("Resource_3"), SubResource("Resource_4")])
story_triggers = PackedStringArray("ch1_b_dinner")
death_credit_cap = 250

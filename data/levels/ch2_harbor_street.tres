[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("3_portal_data")
id = &"street_home"
target_level = "res://data/levels/ch2_pawnshop.tres"
target_portal = &"pawn_front"
prompt = "{interact} 回當舖"
localized_prompts = Dictionary[String, String]({"en": "{interact} Return to the pawnshop", "ja": "{interact} 質屋へ戻る"})
style = "door"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("3_portal_data")
id = &"street_market"
target_level = "res://data/levels/ch2_market_gate.tres"
target_portal = &"gate_street"
prompt = "{interact} 往市集"
localized_prompts = Dictionary[String, String]({"en": "{interact} Go to the market", "ja": "{interact} 市場へ"})
width = 28
height = 44
style = "road"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("3_portal_data")
id = &"street_upper"
target_level = "res://data/levels/ch2_market_gate.tres"
target_portal = &"gate_upper"
prompt = "{interact} 沿雨棚走到市集入口上層"
localized_prompts = Dictionary[String, String]({"en": "{interact} Cross the canopy to the upper market entrance", "ja": "{interact} 雨よけ伝いに市場入口の上層へ"})
width = 28
height = 44
style = "road"

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("4_lighting_zone")
start_tile = 0
blend_tiles = 12
profile = ExtResource("5_alley_calm")

[resource]
script = ExtResource("1_level_data")
id = &"ch2_harbor_street"
display_name = "港區街道（白天）"
localized_names = Dictionary[String, String]({"en": "Harbor Street (Day)", "ja": "港の通り（昼）"})
tile_size = 16
height = 40
legend = Dictionary[String, Resource]({
"c": ExtResource("2_credits_small"),
"h": SubResource("Resource_0"),
"m": SubResource("Resource_1"),
"Ⓕ": ExtResource("94_ch2_street_flyer"),
"Ⓙ": ExtResource("93_ch2_street_news"),
"Ⓚ": ExtResource("92_ch2_street_worker"),
"⇡": SubResource("Resource_2")
})
hints = PackedStringArray("踩著雨棚往右走，可以從上層進市集入口。")
chapter = &"ch2_heron"
persistent_world = true
show_chapter_card = false
environment = ExtResource("6_ch2_harbor_street")
layout_path = "res://data/levels/ch2_harbor_street_map.json"
lighting_zones = Array[ExtResource("4_lighting_zone")]([SubResource("Resource_3")])
story_triggers = PackedStringArray("ch2_b_street_morning")
death_credit_cap = 250

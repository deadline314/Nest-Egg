width = 28
height = 44
style = "road"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("3_lighting_zone")
start_tile = 0
blend_tiles = 12
profile = ExtResource("4_alley_calm")

[resource]
script = ExtResource("1_level_data")
id = &"ch2_harbor_street"
display_name = "港區街道（白天）"
tile_size = 16
height = 24
legend = Dictionary[String, Resource]({
"h": SubResource("Resource_0"),
"m": SubResource("Resource_1")
})
hints = PackedStringArray()
chapter = &"ch2_heron"
persistent_world = true
show_chapter_card = false
environment = ExtResource("5_ch2_harbor_street")

"c": ExtResource("2_credits_small"),
"h": SubResource("Resource_0"),
"m": SubResource("Resource_1"),
"⇡": SubResource("Resource_2")
})
hints = PackedStringArray("踩著雨棚往右走，可以從上層進市集入口。")

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("2_portal_data")
id = &"street_home"
target_level = "res://data/levels/ch2_pawnshop.tres"
target_portal = &"pawn_front"
prompt = "{interact} 回當舖"
style = "door"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_portal_data")
id = &"street_market"
target_level = "res://data/levels/ch2_market_gate.tres"
target_portal = &"gate_street"

height = 24
legend = Dictionary[String, Resource]({
"Ⅱ": SubResource("Resource_0"),
"Ⅲ": SubResource("Resource_1"),
"⇲": SubResource("Resource_2")
})
hints = PackedStringArray()
chapter = &"ch5_paymaster"
persistent_world = true
show_chapter_card = false
environment = ExtResource("4_ch5_harbor_street")
layout_path = "res://data/levels/ch5_harbor_street_map.json"
lighting_zones = Array[ExtResource("3_lighting_zone")]([])
story_triggers = PackedStringArray()
death_credit_cap = 250

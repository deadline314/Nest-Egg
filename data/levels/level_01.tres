[resource]
script = ExtResource("1_script")
id = &"level_01"
display_name = "第一章　雨夜"
tile_size = 16
height = 24
legend = Dictionary[String, Resource]({
"L": ExtResource("10_laser"),
"M": ExtResource("11_bulwark"),
"S": ExtResource("9_spread"),
"X": ExtResource("8_warden"),
"b": ExtResource("6_bomber"),
"d": ExtResource("4_drone"),
"g": ExtResource("2_grunt"),
"m": ExtResource("7_mortar"),
"r": ExtResource("3_rusher"),
"t": ExtResource("5_turret")
})
hints = PackedStringArray("移動 {move_left}/{move_right}，跳躍 {jump}（按久跳更高）", "滑鼠瞄準，{shoot} 射擊；{weapon_next} 或 1～4 換武器", "按住 {block} 舉盾；子彈到的瞬間舉盾＝完美反彈", "{move_down}＋{jump} 從平台落下；{dash} 衝刺時無敵", "監視蜂在頭頂：往斜上方瞄準射擊", "敵人頭上出現青色菱形：按 {melee} 終結，回補彈藥", "鎮暴員正面擋子彈：跳過或衝刺穿越，打背後", "按 {interact} 搭乘機甲：爆炸彈頭無視盾牌", "打爆自爆蟲，爆炸會波及牠的同伴")
decor = Dictionary[String, String]({
"$": "neon_sign",
"%": "neon_sign_h",
"@": "billboard",
"~": "steam_vent"
})
sign_texts = PackedStringArray("拉麵", "薬", "酒場", "義体", "電腦", "茶", "修理", "網咖", "當舖", "夜市", "OPEN", "24H")
billboard_ads = PackedStringArray("天穹集團|讓天空屬於每個人", "NEST 計畫|為了更好的明天", "軌道醫院|治癒，只差一張票", "天穹保全|您的安全，我們的承諾")
intro_scene = &"prologue"
boss_scene = &"boss_intro"
outro_scene = &"epilogue"
story_triggers = PackedStringArray("radio_start", "radio_market", "radio_shield", "radio_mech", "radio_facility", "radio_last")
layout_path = "res://data/levels/level_01_map.json"

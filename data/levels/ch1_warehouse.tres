[resource]
script = ExtResource("1_level_data")
id = &"ch1_warehouse"
display_name = "碼頭倉庫"
tile_size = 16
height = 24
legend = Dictionary[String, Resource]({
"%": ExtResource("2_crate_small"),
"@": ExtResource("3_concrete_chunk"),
"A": ExtResource("4_ch1_switch_a"),
"D": ExtResource("5_fuel_barrel"),
"I": ExtResource("6_pipe"),
"O": SubResource("Resource_0"),
"R": ExtResource("8_ch1_switch_b"),
"U": SubResource("Resource_1"),
"W": ExtResource("9_ch1_flood_pit"),
"a": ExtResource("10_ch1_gate_a"),
"b": ExtResource("11_collector_brute"),
"c": ExtResource("12_credits_small"),
"d": ExtResource("13_drone"),
"g": ExtResource("14_sweeper"),
"i": ExtResource("15_med_injector"),
"k": ExtResource("16_collector_gunner"),
"l": ExtResource("17_doc_dike_log"),
"r": ExtResource("18_ch1_gate_b"),
"s": ExtResource("19_ch1_gate_c"),
"v": ExtResource("20_ch1_gate_watchdog"),
"w": ExtResource("21_watchdog")
})
hints = PackedStringArray("留意大廳深處的看門狗，死亡後牠仍會保留部分傷勢。", "打倒看門狗，前方的隔牆才會升起。", "先在電話亭 B2 備份，再往倉庫裡走。", "按 {interact} 操作開關，控制同一頻道的閘門。", "留意牆上的水位刻度，前方水坑會漲水。", "進入前方的倉庫深處，保險箱旁有守衛。")
chapter = &"ch1_kasa"
persistent_world = true
show_chapter_card = false
environment = ExtResource("24_ch1_warehouse")
layout_path = "res://data/levels/ch1_warehouse_map.json"
lighting_zones = Array[ExtResource("22_lighting_zone")]([SubResource("Resource_2")])
channel_scenes = Dictionary[StringName, StringName]({&"watchdog_gate": &"ch1_c11_watchdog"})
story_triggers = PackedStringArray("ch1_g07_dog", "ch1_g10_pit", "ch1_g10_pit2", "ch1_g10_cross")
death_credit_cap = 250

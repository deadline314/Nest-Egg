[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("3_portal_data")
id = &"wh_upper"
target_level = "res://data/levels/ch1_lounge.tres"
prompt = "{interact} 上層通道（過去就回不來了）"
style = "door"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("3_portal_data")
id = &"wh_street"
target_level = "res://data/levels/ch1_street.tres"
target_portal = &"street_warehouse"
prompt = "{interact} 回街道"
width = 28
height = 48
style = "door"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("26_lighting_zone")
start_tile = 0
blend_tiles = 12
profile = ExtResource("27_freight")

[resource]
script = ExtResource("1_level_data")
id = &"ch1_warehouse"
display_name = "碼頭倉庫"
tile_size = 16
height = 24
legend = Dictionary[String, Resource]({
"A": ExtResource("2_ch1_switch_a"),
"L": SubResource("Resource_0"),
"O": SubResource("Resource_1"),
"R": ExtResource("4_ch1_switch_b"),
"W": ExtResource("5_ch1_flood_pit"),
"X": ExtResource("6_ch1_secret_wall"),
"a": ExtResource("7_ch1_gate_a"),
"b": ExtResource("8_collector_brute"),
"c": ExtResource("9_credits_small"),
"d": ExtResource("10_drone"),
"g": ExtResource("11_sweeper"),
"i": ExtResource("12_med_injector"),
"k": ExtResource("13_collector_gunner"),
"l": ExtResource("14_doc_dike_log"),
"q": ExtResource("15_credits_large"),
"r": ExtResource("16_ch1_gate_b"),
"s": ExtResource("17_ch1_gate_c"),
"v": ExtResource("18_ch1_gate_watchdog"),
"w": ExtResource("19_watchdog"),
"y": ExtResource("20_ch1_data_disk"),
"z": ExtResource("21_ch1_inspector"),
"ε": ExtResource("22_ch1_enc_warehouse_vault"),
"ζ": ExtResource("23_ch1_arena_warehouse_vault"),
"η": ExtResource("24_ch1_enc_warehouse_walkway"),
"θ": ExtResource("25_ch1_arena_warehouse_walkway")
})
hints = PackedStringArray("看門狗睡在大廳深處：牠的傷會留著，死了不白死", "隔牆：打倒看門狗才會升起", "電話亭 B2：先備份，再往裡走", "開關：按 {interact} 切換，閘門跟著開關", "牆上的水位刻度很高：這個坑會漲水", "保險箱裡有一片資料盤：拿了就能從上層通道離開")
chapter = &"ch1_kasa"
persistent_world = true
show_chapter_card = false
environment = ExtResource("28_ch1_warehouse")
layout_path = "res://data/levels/ch1_warehouse_map.json"
lighting_zones = Array[ExtResource("26_lighting_zone")]([SubResource("Resource_2")])
channel_scenes = Dictionary[StringName, StringName]({&"watchdog_gate": &"ch1_c11_watchdog"})
story_triggers = PackedStringArray("ch1_g07_dog", "ch1_g10_pit", "ch1_g10_pit2", "ch1_g10_cross", "ch1_g10_disk")
death_credit_cap = 250

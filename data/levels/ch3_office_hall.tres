[gd_resource type="Resource" script_class="LevelData" load_steps=12 format=3]

[ext_resource type="Script" path="res://data/scripts/level_data.gd" id="1_level_data"]
[ext_resource type="Script" path="res://data/scripts/portal_data.gd" id="2_portal_data"]
[ext_resource type="Resource" path="res://data/npcs/ch3_waiting_bench.tres" id="3_ch3_waiting_bench"]
[ext_resource type="Resource" path="res://data/npcs/ch3_petition_box.tres" id="4_ch3_petition_box"]
[ext_resource type="Script" path="res://data/scripts/lighting_zone.gd" id="5_lighting_zone"]
[ext_resource type="Resource" path="res://data/lighting/tower_white.tres" id="6_tower_white"]
[ext_resource type="Resource" path="res://data/environment/themes/ch3_office_hall.tres" id="7_ch3_office_hall"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("2_portal_data")
id = &"hall_show"
target_level = "res://data/levels/ch3_showroom.tres"
target_portal = &"show_hall"
prompt = "{interact} 回樣品房"
style = "door"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_portal_data")
id = &"hall_edge"
target_level = "res://data/levels/ch3_glass_edge.tres"
target_portal = &"edge_hall"
prompt = "{interact} 沿候梯迴廊回玻璃邊緣"
style = "door"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_portal_data")
id = &"hall_office"
locked_text = "辦公內門需要職員證，迴廊只到等候臺。"
prompt = "{interact} 辦公內門"
style = "door"

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("5_lighting_zone")
start_tile = 0
blend_tiles = 12
profile = ExtResource("6_tower_white")

[resource]
script = ExtResource("1_level_data")
id = &"ch3_office_hall"
display_name = "天穹辦公接待廊"
tile_size = 16
height = 24
legend = Dictionary[String, Resource]({
"Ⅺ": SubResource("Resource_0"),
"Ⅻ": SubResource("Resource_1"),
"ⅷ": SubResource("Resource_2"),
"Ⓦ": ExtResource("3_ch3_waiting_bench"),
"ⓧ": ExtResource("4_ch3_petition_box")
})
hints = PackedStringArray()
chapter = &"ch3_clearwater"
persistent_world = true
show_chapter_card = false
environment = ExtResource("7_ch3_office_hall")
layout_path = "res://data/levels/ch3_office_hall_map.json"
lighting_zones = Array[ExtResource("5_lighting_zone")]([SubResource("Resource_3")])
story_triggers = PackedStringArray()
rain = false
death_credit_cap = 250

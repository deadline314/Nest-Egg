[gd_resource type="Resource" script_class="LevelData" load_steps=10 format=3]

[ext_resource type="Script" path="res://data/scripts/level_data.gd" id="1_level_data"]
[ext_resource type="Script" path="res://data/scripts/portal_data.gd" id="2_portal_data"]
[ext_resource type="Resource" path="res://data/npcs/ch1_ali_lounge.tres" id="3_ch1_ali_lounge"]
[ext_resource type="Script" path="res://data/scripts/lighting_zone.gd" id="4_lighting_zone"]
[ext_resource type="Resource" path="res://data/lighting/lounge_safe.tres" id="5_lounge_safe"]
[ext_resource type="Resource" path="res://data/environment/themes/ch1_lounge.tres" id="6_ch1_lounge"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("2_portal_data")
id = &"lounge_exit"
target_level = "res://data/levels/ch1_stall.tres"
requires_flag = &"ch1_lounge_evening_done"
locked_text = "先和阿梨說完今晚的話，再去門外麵攤。"
mode = 1
width = 20
height = 44
style = "road"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_portal_data")
id = &"lounge_handoff"
target_level = "res://data/levels/ch1_handoff.tres"
target_portal = &"handoff_lounge"
prompt = "{interact} 回館外交接櫃"
width = 24
height = 72
style = "door"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("4_lighting_zone")
start_tile = 0
blend_tiles = 12
profile = ExtResource("5_lounge_safe")

[resource]
script = ExtResource("1_level_data")
id = &"ch1_lounge"
display_name = "復原館"
tile_size = 16
height = 24
legend = Dictionary[String, Resource]({
"G": SubResource("Resource_0"),
"Y": ExtResource("3_ch1_ali_lounge"),
"↩": SubResource("Resource_1")
})
hints = PackedStringArray()
chapter = &"ch1_kasa"
persistent_world = true
show_chapter_card = false
environment = ExtResource("6_ch1_lounge")
layout_path = "res://data/levels/ch1_lounge_map.json"
lighting_zones = Array[ExtResource("4_lighting_zone")]([SubResource("Resource_2")])
story_triggers = PackedStringArray("ch1_b_lounge")
death_credit_cap = 250

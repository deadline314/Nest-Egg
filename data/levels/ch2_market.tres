[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("3_portal_data")
id = &"market_gate"
target_level = "res://data/levels/ch2_market_gate.tres"
target_portal = &"gate_market"
prompt = "{interact} 回市集入口"
localized_prompts = Dictionary[String, String]({"en": "{interact} Return to the market entrance", "ja": "{interact} 市場入口へ戻る"})
width = 28
height = 44
style = "road"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("3_portal_data")
id = &"market_stairs"
target_level = "res://data/levels/ch2_ali_home.tres"
target_portal = &"home_stairs"
prompt = "{interact} 走後樓外梯"
localized_prompts = Dictionary[String, String]({"en": "{interact} Take the rear stairs", "ja": "{interact} 裏棟の外階段へ"})
style = "door"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("3_portal_data")
id = &"market_cargo"
target_level = "res://data/levels/ch2_loading.tres"
target_portal = &"loading_market"
requires_flag = &"ch2_market_contact_done"
locked_text = "先到代收處問清楚這筆代收款，再去後面查帳。"
localized_locked_text = Dictionary[String, String]({"en": "Ask the collection desk about the payment before checking the accounts.", "ja": "帳簿を調べる前に、集金所でこの支払いについて聞く。"})
prompt = "{interact} 往雨棚背面的貨道"
localized_prompts = Dictionary[String, String]({"en": "{interact} Take the loading passage behind the canopy", "ja": "{interact} 雨よけ裏の搬入口へ"})
width = 28
height = 44
style = "road"

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("3_portal_data")
id = &"market_sc1"
target_level = "res://data/levels/ch2_loading.tres"
target_portal = &"loading_sc1"
requires_flag = &"ch2_sc1_open"
locked_text = "橋梯收在上面，要從裝卸間那一側放下來。"
localized_locked_text = Dictionary[String, String]({"en": "Lower the bridge ladder from the loading room side.", "ja": "荷さばき室側から橋のはしごを下ろす。"})
prompt = "{interact} 走橋梯捷徑到裝卸間"
localized_prompts = Dictionary[String, String]({"en": "{interact} Take the bridge ladder to the loading room", "ja": "{interact} 橋のはしごで荷さばき室へ近道する"})
style = "door"

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("3_portal_data")
id = &"market_service_lounge"
target_level = "res://data/levels/ch2_lounge_front.tres"
target_portal = &"lounge_service_market"
requires_flag = &"ch2_audit_submitted"
locked_text = "先在復原館的委託終端送出查核資料，員工通道才會開放。"
localized_locked_text = Dictionary[String, String]({"en": "Submit the audit at Restoration Hall's commission terminal to unlock the staff passage.", "ja": "復元館の依頼端末で監査資料を送信すると、職員通路が開きます。"})
prompt = "{interact} 走員工通道到復原館"
localized_prompts = Dictionary[String, String]({"en": "{interact} Use the staff passage to Restoration Hall", "ja": "{interact} 職員通路から復元館へ"})
width = 32
height = 68
style = "hidden"


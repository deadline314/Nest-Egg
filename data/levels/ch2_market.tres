[gd_resource type="Resource" script_class="LevelData" load_steps=20 format=3]

[ext_resource type="Script" path="res://data/scripts/level_data.gd" id="1_level_data"]
[ext_resource type="Resource" path="res://data/props/credits_small.tres" id="2_credits_small"]
[ext_resource type="Script" path="res://data/scripts/portal_data.gd" id="3_portal_data"]
[ext_resource type="Resource" path="res://data/npcs/ch2_banyan.tres" id="4_ch2_banyan"]
[ext_resource type="Resource" path="res://data/npcs/ch2_notice_screen.tres" id="5_ch2_notice_screen"]
[ext_resource type="Resource" path="res://data/npcs/ch2_vig.tres" id="6_ch2_vig"]
[ext_resource type="Resource" path="res://data/npcs/ch2_rent_window.tres" id="7_ch2_rent_window"]
[ext_resource type="Resource" path="res://data/npcs/ch2_ali_market.tres" id="8_ch2_ali_market"]
[ext_resource type="Resource" path="res://data/npcs/ch2_hawker.tres" id="9_ch2_hawker"]
[ext_resource type="Script" path="res://data/scripts/lighting_zone.gd" id="10_lighting_zone"]
[ext_resource type="Resource" path="res://data/lighting/market.tres" id="11_market"]
[ext_resource type="Resource" path="res://data/environment/themes/ch2_market.tres" id="12_ch2_market"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("3_portal_data")
id = &"market_gate"
target_level = "res://data/levels/ch2_market_gate.tres"
target_portal = &"gate_market"
prompt = "{interact} 回市集入口"
width = 28
height = 44
style = "road"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("3_portal_data")
id = &"market_stairs"
target_level = "res://data/levels/ch2_ali_home.tres"
target_portal = &"home_stairs"
prompt = "{interact} 走後樓外梯"
style = "door"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("3_portal_data")
id = &"market_cargo"
target_level = "res://data/levels/ch2_loading.tres"
target_portal = &"loading_market"
requires_flag = &"ch2_market_contact_done"
locked_text = "先到代收處問清楚這筆代收款，再去後面查帳。"
prompt = "{interact} 往雨棚背面的貨道"
width = 28
height = 44
style = "road"

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("3_portal_data")
id = &"market_sc1"
target_level = "res://data/levels/ch2_loading.tres"
target_portal = &"loading_sc1"
requires_flag = &"ch2_sc1_open"
locked_text = "橋梯收在上面，要從裝卸間那一側放下來。"
prompt = "{interact} 走橋梯捷徑到裝卸間"
style = "door"

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("3_portal_data")
id = &"market_roof"
target_level = "res://data/levels/ch2_ali_home.tres"
target_portal = &"home_roof"
prompt = "{interact} 從後窗進阿梨的小廚房"
width = 24
height = 44
style = "door"

[sub_resource type="Resource" id="Resource_5"]
script = ExtResource("3_portal_data")
id = &"market_canopy"
target_level = "res://data/levels/ch2_loading.tres"
target_portal = &"loading_canopy"
requires_flag = &"ch2_market_contact_done"
locked_text = "先到代收處問清楚這筆代收款，再去後面查帳。"
prompt = "{interact} 沿雨棚走到貨道上層"
width = 28
height = 44
style = "road"

[sub_resource type="Resource" id="Resource_6"]
script = ExtResource("10_lighting_zone")
start_tile = 0
blend_tiles = 12
profile = ExtResource("11_market")

[resource]
script = ExtResource("1_level_data")
id = &"ch2_market"
display_name = "公眾攤道"
tile_size = 16
height = 40
legend = Dictionary[String, Resource]({
"c": ExtResource("2_credits_small"),
"Ⅴ": SubResource("Resource_0"),
"Ⅵ": SubResource("Resource_1"),
"Ⅶ": SubResource("Resource_2"),
"Ⅷ": SubResource("Resource_3"),
"⇠": SubResource("Resource_4"),
"⇢": SubResource("Resource_5"),
"Ⓑ": ExtResource("4_ch2_banyan"),
"Ⓝ": ExtResource("5_ch2_notice_screen"),
"Ⓥ": ExtResource("6_ch2_vig"),
"Ⓦ": ExtResource("7_ch2_rent_window"),
"ⓐ": ExtResource("8_ch2_ali_market"),
"ⓗ": ExtResource("9_ch2_hawker")
})
hints = PackedStringArray("雨棚上層通往阿梨家的後窗與後面的貨道。")
chapter = &"ch2_heron"
persistent_world = true
show_chapter_card = false
environment = ExtResource("12_ch2_market")
layout_path = "res://data/levels/ch2_market_map.json"
lighting_zones = Array[ExtResource("10_lighting_zone")]([SubResource("Resource_6")])
story_triggers = PackedStringArray()
death_credit_cap = 250

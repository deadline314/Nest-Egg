[gd_resource type="Resource" script_class="LevelData" load_steps=7 format=3]

[ext_resource type="Script" path="res://data/scripts/level_data.gd" id="1_level_data"]
[ext_resource type="Script" path="res://data/scripts/portal_data.gd" id="2_portal_data"]
[ext_resource type="Script" path="res://data/scripts/lighting_zone.gd" id="3_lighting_zone"]
[ext_resource type="Resource" path="res://data/environment/themes/ch5_phone_alley.tres" id="4_ch5_phone_alley"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("2_portal_data")
id = &"phone_street"
target_level = "res://data/levels/ch5_harbor_street.tres"
target_portal = &"street_phone"
prompt = "{interact} 回港區街道"
localized_prompts = Dictionary[String, String]({"en": "{interact} Return to Harbor Street", "ja": "{interact} 港の通りに戻る"})
width = 30
height = 63
style = "door"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_portal_data")
id = &"phone_gray"
target_level = "res://data/levels/ch5_gray_path.tres"
target_portal = &"gray_phone"
requires_flag = &"ch5_gray_return_unlatched"
locked_text = "先從灰道小桌那一側打開回口。"
localized_locked_text = Dictionary[String, String]({"en": "Release the latch from the service table side first.", "ja": "先に灰道の小机側から留め金を外す。"})
prompt = "{interact} 從灰道回小桌"
localized_prompts = Dictionary[String, String]({"en": "{interact} Return to the service table", "ja": "{interact} 灰道の小机に戻る"})
width = 30
height = 63
style = "door"

[resource]
script = ExtResource("1_level_data")
id = &"ch5_phone_alley"
display_name = "電話亭巷"
localized_names = Dictionary[String, String]({"en": "Phone Booth Alley", "ja": "電話ボックス横丁"})
tile_size = 16
height = 24
legend = Dictionary[String, Resource]({
"Ⅸ": SubResource("Resource_0"),
"Ⅺ": SubResource("Resource_1")
})
hints = PackedStringArray()
chapter = &"ch5_paymaster"
persistent_world = true
show_chapter_card = false
environment = ExtResource("4_ch5_phone_alley")
layout_path = "res://data/levels/ch5_phone_alley_map.json"
lighting_zones = Array[ExtResource("3_lighting_zone")]([])
story_triggers = PackedStringArray()
death_credit_cap = 250

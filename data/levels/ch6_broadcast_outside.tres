[gd_resource type="Resource" script_class="LevelData" load_steps=15 format=3]

[ext_resource type="Script" path="res://data/scripts/level_data.gd" id="1_level_data"]
[ext_resource type="Script" path="res://data/scripts/portal_data.gd" id="2_portal_data"]
[ext_resource type="Resource" path="res://data/npcs/ch6_relay_diverter.tres" id="3_ch6_relay_diverter"]
[ext_resource type="Resource" path="res://data/npcs/ch6_yard_gauge.tres" id="4_ch6_yard_gauge"]
[ext_resource type="Resource" path="res://data/npcs/ch6_relay_backup.tres" id="5_ch6_relay_backup"]
[ext_resource type="Resource" path="res://data/npcs/ch6_relay_drain.tres" id="6_ch6_relay_drain"]
[ext_resource type="Resource" path="res://data/npcs/ch6_su_canopy.tres" id="7_ch6_su_canopy"]
[ext_resource type="Script" path="res://data/scripts/lighting_zone.gd" id="8_lighting_zone"]
[ext_resource type="Resource" path="res://data/lighting/ch6_studio_light.tres" id="9_ch6_studio_light"]
[ext_resource type="Resource" path="res://data/environment/themes/ch6_broadcast_outside.tres" id="10_ch6_broadcast_outside"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("2_portal_data")
id = &"relay_overpass"
target_level = "res://data/levels/ch6_broadcast_overpass.tres"
target_portal = &"overpass_relay"
prompt = "{interact} 回高架維修道"
localized_prompts = Dictionary[String, String]({"en": "{interact} Return to the maintenance overpass", "ja": "{interact} 高架の保守路に戻る"})
width = 30
height = 63
style = "door"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_portal_data")
id = &"relay_recording"
target_level = "res://data/levels/ch6_recording_booth.tres"
target_portal = &"recording_relay"
requires_flag = &"ch6_relay_powered"
locked_text = "先讓水位降到白線下，再接通上層備援電源。"
localized_locked_text = Dictionary[String, String]({"en": "Lower the water below the white mark and connect backup power upstairs.", "ja": "水位を白線より下げてから、上層の予備電源をつなぐ。"})
prompt = "{interact} 進錄音室"
localized_prompts = Dictionary[String, String]({"en": "{interact} Enter the recording booth", "ja": "{interact} 録音室に入る"})
width = 30
height = 63
style = "hidden"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_portal_data")
id = &"relay_rain"
target_level = "res://data/levels/ch6_rain_chase_alley.tres"
target_portal = &"rain_relay"
requires_flag = &"ali_call_relayed"
locked_text = "先從錄音室接到燈轉來的電話。"
localized_locked_text = Dictionary[String, String]({"en": "Receive the forwarded call from Lamp in the booth first.", "ja": "まず録音室で灯からの転送電話を受ける。"})
prompt = "{interact} 往市集外街"
localized_prompts = Dictionary[String, String]({"en": "{interact} Enter the market side street", "ja": "{interact} 市場の外通りへ"})
width = 30
height = 63
style = "door"

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("8_lighting_zone")
start_tile = 49
blend_tiles = 5
profile = ExtResource("9_ch6_studio_light")

[resource]
script = ExtResource("1_level_data")
id = &"ch6_broadcast_outside"
display_name = "廣播站前庭"
localized_names = Dictionary[String, String]({"en": "Broadcast Relay Yard", "ja": "放送局前庭"})
tile_size = 16
height = 24
legend = Dictionary[String, Resource]({
"ⅴ": SubResource("Resource_0"),
"ⅵ": SubResource("Resource_1"),
"ⅷ": SubResource("Resource_2"),
"ⓓ": ExtResource("3_ch6_relay_diverter"),
"ⓖ": ExtResource("4_ch6_yard_gauge"),
"ⓟ": ExtResource("5_ch6_relay_backup"),
"ⓡ": ExtResource("6_ch6_relay_drain"),
"ⓢ": ExtResource("7_ch6_su_canopy")
})
hints = PackedStringArray()
chapter = &"ch6_unmooring"
persistent_world = true
show_chapter_card = false
environment = ExtResource("10_ch6_broadcast_outside")
layout_path = "res://data/levels/ch6_broadcast_outside_map.json"
lighting_zones = Array[ExtResource("8_lighting_zone")]([SubResource("Resource_3")])
story_triggers = PackedStringArray()
death_credit_cap = 250

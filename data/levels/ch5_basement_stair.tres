"⇘": SubResource("Resource_0"),
"♧": ExtResource("3_ch5_bian_coat"),
"⤊": SubResource("Resource_1")
})
hints = PackedStringArray()
chapter = &"ch5_paymaster"
persistent_world = true
show_chapter_card = false
environment = ExtResource("5_ch5_basement_stair")
layout_path = "res://data/levels/ch5_basement_stair_map.json"
lighting_zones = Array[ExtResource("4_lighting_zone")]([])
avoidance_encounter = ExtResource("6_ch5_stair_avoidance")

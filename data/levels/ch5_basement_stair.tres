[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("2_portal_data")
id = &"stair_basement"
target_level = "res://data/levels/ch5_basement_archive.tres"
target_portal = &"basement_stair"
requires_flag = &"ch5_bian_coat_identified"
locked_text = "先查看灰衣人留下的外套。"
localized_locked_text = Dictionary[String, String]({"en": "Examine the coat left by the person in gray.", "ja": "灰色のコートの人物が残した服を調べよう。"})
prompt = "{interact} 下樓進地下室"
localized_prompts = Dictionary[String, String]({"en": "{interact} Descend into the basement", "ja": "{interact} 地下室へ下りる"})
width = 28
height = 64
style = "door"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_portal_data")
id = &"stair_alley"
target_level = "res://data/levels/ch5_back_alley.tres"
target_portal = &"alley_stair"
prompt = "{interact} 回當舖後巷"
localized_prompts = Dictionary[String, String]({"en": "{interact} Return to the pawnshop back alley", "ja": "{interact} 質屋の裏路地に戻る"})
width = 30
height = 64
style = "door"

[resource]
script = ExtResource("1_level_data")
id = &"ch5_basement_stair"
display_name = "地下室樓梯口"

[resource]
script = ExtResource("1_level_data")
id = &"ch1_street"
display_name = "港區街道"
tile_size = 16
height = 24
legend = Dictionary[String, Resource]({
"%": ExtResource("2_crate_small"),
"D": ExtResource("3_fuel_barrel"),
"I": ExtResource("4_pipe"),
"N": SubResource("Resource_0"),
"X": ExtResource("6_ch1_secret_wall"),
"b": ExtResource("7_collector_brute"),
"c": ExtResource("8_credits_small"),
"d": ExtResource("9_drone"),
"e": ExtResource("10_shield_cell"),
"f": ExtResource("11_doc_echo_flyer"),
"g": ExtResource("12_sweeper"),
"h": SubResource("Resource_1"),
"i": ExtResource("13_med_injector"),
"j": SubResource("Resource_2"),
"k": ExtResource("14_collector_gunner"),
"m": SubResource("Resource_3"),
"o": ExtResource("15_doc_collection_notice"),
"q": ExtResource("16_credits_large"),
"z": ExtResource("17_ch1_inspector"),
"α": ExtResource("18_ch1_enc_street_plaza"),
"β": ExtResource("19_ch1_arena_street_plaza"),
"γ": ExtResource("20_ch1_enc_street_blockade"),
"δ": ExtResource("21_ch1_arena_street_blockade")
})
hints = PackedStringArray("街上有人發傳單、有人聊天，不是每個人都想打你。", "街角的巷子裡有電話亭，先去備份，死了才有地方醒來。", "前面有清掃兵，靠著箱子瞄準射擊，打完再縮回去。", "子彈到的瞬間才舉盾 {block}，就能把子彈反彈回去。", "敵人頭上出現青色菱形時，按 {melee} 終結他並補回彈藥。", "前面是碼頭倉庫，看門狗睡在大廳深處，走進去再決定要不要叫醒牠。")
chapter = &"ch1_kasa"
persistent_world = true
show_chapter_card = false
environment = ExtResource("25_ch1_street")
layout_path = "res://data/levels/ch1_street_map.json"
lighting_zones = Array[ExtResource("22_lighting_zone")]([SubResource("Resource_4"), SubResource("Resource_5")])
channel_cleared_flags = Dictionary[StringName, StringName]({&"arena_street_blockade": &"ch1_street_route_open"})
story_triggers = PackedStringArray("ch1_b_street_in", "ch1_g06_lamp", "ch1_g06_tip_slide", "ch1_g06_tip_blade", "ch1_g06_tip_collector", "ch1_g06_clear")
death_credit_cap = 250

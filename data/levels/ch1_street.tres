[resource]
script = ExtResource("1_level_data")
id = &"ch1_street"
display_name = "港區街道"
tile_size = 16
height = 24
legend = Dictionary[String, Resource]({
"N": SubResource("Resource_0"),
"X": ExtResource("3_ch1_secret_wall"),
"b": ExtResource("4_collector_brute"),
"c": ExtResource("5_credits_small"),
"d": ExtResource("6_drone"),
"e": ExtResource("7_shield_cell"),
"f": ExtResource("8_doc_echo_flyer"),
"g": ExtResource("9_sweeper"),
"h": SubResource("Resource_1"),
"i": ExtResource("10_med_injector"),
"j": SubResource("Resource_2"),
"k": ExtResource("11_collector_gunner"),
"m": SubResource("Resource_3"),
"o": ExtResource("12_doc_collection_notice"),
"q": ExtResource("13_credits_large"),
"z": ExtResource("14_ch1_inspector"),
"α": ExtResource("15_ch1_enc_street_plaza"),
"β": ExtResource("16_ch1_arena_street_plaza"),
"γ": ExtResource("17_ch1_enc_street_blockade"),
"δ": ExtResource("18_ch1_arena_street_blockade"),
"T": ExtResource("t_fuel_barrel"),
"x": ExtResource("t_crate_small"),
"p": ExtResource("t_pipe")
})
hints = PackedStringArray("街上有人發傳單、有人聊天，不是每個人都想打你", "街角的巷子裡有電話亭：先去備份，死了才有地方醒來", "清掃兵在前面：靠著箱子，瞄準、射擊、再縮回去", "按住 {block} 舉盾；子彈到的瞬間舉盾＝完美反彈", "敵人頭上出現青色菱形：按 {melee} 終結，回補彈藥", "碼頭倉庫：看門狗睡在大廳深處，走進去再決定要不要叫醒牠")
chapter = &"ch1_kasa"
persistent_world = true
show_chapter_card = false
environment = ExtResource("22_ch1_street")
layout_path = "res://data/levels/ch1_street_map.json"
lighting_zones = Array[ExtResource("19_lighting_zone")]([SubResource("Resource_4"), SubResource("Resource_5")])
story_triggers = PackedStringArray("ch1_b_street_in", "ch1_g06_lamp", "ch1_g06_tip_slide", "ch1_g06_tip_blade", "ch1_g06_tip_collector", "ch1_g06_clear")
death_credit_cap = 250

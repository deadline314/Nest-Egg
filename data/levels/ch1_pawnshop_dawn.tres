height = 24
legend = Dictionary[String, Resource]({
"F": SubResource("Resource_0"),
"K": SubResource("Resource_1"),
"S": SubResource("Resource_2"),
"c": ExtResource("3_credits_small"),
"t": ExtResource("4_doc_pawn_stub"),
"u": ExtResource("5_melee_dagger"),
"x": ExtResource("6_ch1_crate")
})
hints = PackedStringArray("移動 {move_left}/{move_right}，跳躍 {jump}（按久跳更高）", "按 {inventory} 開背包：武器改裝、道具與文件都在這裡", "滑鼠瞄準，{shoot} 射擊；{reload} 換彈。打左邊的木箱練習", "{dash} 衝刺：短暫無敵，可以穿過危險", "{move_down}＋{jump} 從單向平台落下；{melee} 近戰", "樓梯通往屋頂：鷺在上面等你")
chapter = &"ch1_kasa"
persistent_world = true
show_chapter_card = false

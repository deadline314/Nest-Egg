[gd_resource type="Resource" script_class="LevelData" load_steps=12 format=3]

[ext_resource type="Script" path="res://data/scripts/level_data.gd" id="1_level_data"]
[ext_resource type="Script" path="res://data/scripts/portal_data.gd" id="2_portal_data"]
[ext_resource type="Resource" path="res://data/npcs/ch4_safety_instruction.tres" id="3_ch4_safety_instruction"]
[ext_resource type="Resource" path="res://data/npcs/ch4_safety_catch.tres" id="4_ch4_safety_catch"]
[ext_resource type="Script" path="res://data/scripts/lighting_zone.gd" id="5_lighting_zone"]
[ext_resource type="Resource" path="res://data/lighting/ch4_loading_bay.tres" id="6_ch4_loading_bay"]
[ext_resource type="Resource" path="res://data/environment/themes/ch4_factory_safety.tres" id="7_ch4_factory_safety"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("2_portal_data")
id = &"safety_relay"
target_level = "res://data/levels/ch4_factory_relay.tres"
target_portal = &"relay_safe"
prompt = "{interact} 回廠房接線廊"
localized_prompts = Dictionary[String, String]({"en": "{interact} Return to the service walk", "ja": "{interact} 配線通路へ戻る"})
width = 32
height = 68
style = "door"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_portal_data")
id = &"safety_work"
target_level = "res://data/levels/ch4_factory_work.tres"
target_portal = &"work_safety"
requires_flag = &"ch4_cleaning_briefing_read"
locked_text = "先在安全臺聽完廠內廣播。"
localized_locked_text = Dictionary[String, String]({"en": "Listen to the announcement at the safe platform first.", "ja": "まず安全台で工場内放送を聞く。"})
prompt = "{interact} 進清理工作帶"
localized_prompts = Dictionary[String, String]({"en": "{interact} Enter the sweep work lane", "ja": "{interact} 清掃作業帯へ入る"})
width = 32
height = 68
style = "door"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_portal_data")
id = &"safety_service"
target_level = "res://data/levels/ch4_factory_loading.tres"
target_portal = &"loading_service"
requires_flag = &"ch4_safety_shortcut_open"
locked_text = "先放開安全臺的門栓。"
localized_locked_text = Dictionary[String, String]({"en": "Release the latch at the safe platform first.", "ja": "まず安全台の錠を外す。"})
prompt = "{interact} 沿員工捷徑回裝卸帶"
localized_prompts = Dictionary[String, String]({"en": "{interact} Return via the staff shortcut", "ja": "{interact} 職員通路で荷さばき場に戻る"})
width = 32
height = 68
style = "door"

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("5_lighting_zone")
start_tile = 0
blend_tiles = 12
profile = ExtResource("6_ch4_loading_bay")

[resource]
script = ExtResource("1_level_data")
id = &"ch4_factory_safety"
display_name = "清理線安全臺"
localized_names = Dictionary[String, String]({"en": "Sweep Line Safe Platform", "ja": "清掃線の安全台"})
tile_size = 16
height = 24
legend = Dictionary[String, Resource]({
"↡": SubResource("Resource_0"),
"↦": SubResource("Resource_1"),
"ⓘ": ExtResource("3_ch4_safety_instruction"),
"ⓤ": ExtResource("4_ch4_safety_catch"),
"⤓": SubResource("Resource_2")
})
hints = PackedStringArray()
chapter = &"ch4_hollow"
persistent_world = true
show_chapter_card = false
environment = ExtResource("7_ch4_factory_safety")
layout_path = "res://data/levels/ch4_factory_safety_map.json"
lighting_zones = Array[ExtResource("5_lighting_zone")]([SubResource("Resource_3")])
story_triggers = PackedStringArray()
death_credit_cap = 250

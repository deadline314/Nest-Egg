height = 24
legend = Dictionary[String, Resource]({
"⇖": SubResource("Resource_0"),
"⏵": SubResource("Resource_1"),
"▤": ExtResource("3_ch5_life_notebook"),
"◫": ExtResource("4_ch5_redemption_appendix"),
"☰": ExtResource("5_ch5_anchor_counterfoil"),
"♜": ExtResource("6_ch5_archive_old_k"),
"♮": ExtResource("7_ch5_anchor_chair")
})
hints = PackedStringArray()
chapter = &"ch5_paymaster"
persistent_world = true
show_chapter_card = false
environment = ExtResource("10_ch5_basement_archive")

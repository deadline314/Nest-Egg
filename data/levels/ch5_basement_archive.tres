[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("2_portal_data")
id = &"basement_stair"
target_level = "res://data/levels/ch5_basement_stair.tres"
target_portal = &"stair_basement"
prompt = "{interact} 上樓回梯口"
localized_prompts = Dictionary[String, String]({"en": "{interact} Go back up to the stairwell", "ja": "{interact} 階段口へ戻る"})
width = 28
height = 64
style = "door"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_portal_data")
id = &"flood_memory_chip"
local_replay = "res://game/cutscene/local_replay/flood_memory.tscn"
requires_flag = &"ch5_anchor_identity_confirmed"
locked_text = "先核對錨椅旁的登記記錄。"
localized_locked_text = Dictionary[String, String]({"en": "Check the registration record beside the chair first.", "ja": "先に椅子のそばの登録記録を照合する。"})
prompt = "{interact} 播放洪水回放"
localized_prompts = Dictionary[String, String]({"en": "{interact} Play the flood memory", "ja": "{interact} 洪水の記憶を再生する"})
width = 28
height = 44
style = "hidden"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("8_lighting_zone")
start_tile = 14
blend_tiles = 5
profile = ExtResource("9_basement_amber")

[resource]
script = ExtResource("1_level_data")
id = &"ch5_basement_archive"
display_name = "地下室檔案間"

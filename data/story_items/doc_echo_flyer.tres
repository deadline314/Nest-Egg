[resource]
script = ExtResource("1_script")
id = &"doc_echo_flyer"
display_name = "回音派傳單"
description = "港區廣場有人在發的傳單。"
color = Color(0.56, 0.88, 1.00, 1.0)
category = 1
chapter = &"ch1_kasa"
body = "回音派說復原出來的東西只是回音，原來的人早就不在了。你聽見的每一句話都是別人說剩下的。週日傍晚到港口廣場可以免費聽講。背面有人用鉛筆寫著「我爸說的不一樣」。"
order = 20
trigger = 3
icon = "doc_flyer"

[resource]
script = ExtResource("1_script")
id = &"rec_old_k_voicemail"
display_name = "老K的語音留言"
description = "老K在你出門前留的語音。"
color = Color(1.0, 0.82, 0.25, 1.0)
category = 2
chapter = &"chapter_01"
body = "小鬼，聽到這段時我大概又在擔心了。拿了東西就回來，別再逞強喔。粥已煮好放在桌上。航昨晚咳得兇，你回來先看他。瓦斯又漲價了，你別把爐子忘在那裡喔。"

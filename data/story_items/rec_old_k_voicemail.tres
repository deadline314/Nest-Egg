script = ExtResource("1_script")
id = &"rec_old_k_voicemail"
display_name = "老K的語音留言"
description = "老K在你出門前留的語音。"
color = Color(1.0, 0.82, 0.25, 1.0)
category = 2
chapter = &"chapter_01"
body = "小鬼，你聽到這段的時候，我大概又在擔心了。拿了東西就回來，別逞強。粥我煮好放桌上了。航昨晚咳得兇，你回來先看他。瓦斯又漲了，你喔。"

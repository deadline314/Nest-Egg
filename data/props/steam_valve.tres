[gd_resource type="Resource" script_class="SteamValveData" format=3]

[ext_resource type="Script" path="res://data/scripts/steam_valve_data.gd" id="1_valve"]

[resource]
script = ExtResource("1_valve")
id = &"steam_valve"
display_name = "蒸汽閥"
hint = "射擊閥門噴出蒸汽，幾秒內擋住雙方的子彈。"

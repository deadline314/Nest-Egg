  "boss_land":          {"shake": {"px": 4.8, "time": 0.3}},
  "boss_phase_shift":   {"shake": {"px": 5.6, "time": 0.6}, "zoom": {"amount": 0.02, "time": 0.5}},
  "cyber_pulse":        {"shake": {"px": 2.4, "time": 0.2}},
  "player_melee_hit":   {"freeze": 0.05, "shake": {"px": 1.6, "time": 0.08}},

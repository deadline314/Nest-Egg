  "player_death":       {"hitstop": 0.14, "shake": {"px": 4.8, "time": 0.3}},
  "breakable_break":    {"shake": {"px": 2.0, "time": 0.15}},
  "gate_open":          {"shake": {"px": 1.2, "time": 0.2}},
  "vehicle_stomp":      {"shake": {"px": 2.4, "time": 0.15}},
  "vehicle_hurt":       {"shake": {"px": 1.6, "time": 0.1}}
 }

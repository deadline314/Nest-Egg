{
 "_說明": "手感預設組合：對所有回饋事件的整體倍率（shake 震動、hitstop 頓幀與局部凍結、zoom 縮放脈衝）。standard 是設計值；玩家設定頁的滑桿再乘在這之上。",
 "presets": {
  "standard":   {"label": "標準", "shake": 1.0, "hitstop": 1.0, "zoom": 1.0},
  "restrained": {"label": "克制", "shake": 0.6, "hitstop": 0.7, "zoom": 0.5},
  "heavy":      {"label": "厚重", "shake": 1.4, "hitstop": 1.4, "zoom": 1.3},
  "arcade":     {"label": "街機", "shake": 1.2, "hitstop": 0.6, "zoom": 1.6},
  "accessible": {"label": "無障礙", "shake": 0.0, "hitstop": 0.0, "zoom": 0.0}
 }
}

[resource]
script = ExtResource("1_npc_data")
id = &"ch1_old_k"
display_name = "老 K"
speaker = "old_k"
rig_id = "old_k"
loop = &"wipe_hands"
facing = -1
prompt = "{interact} 和老 K 說話"

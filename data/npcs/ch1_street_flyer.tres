[gd_resource type="Resource" script_class="NpcData" load_steps=11 format=3]

[ext_resource type="Script" path="res://data/scripts/npc_data.gd" id="1_npc_data"]
[ext_resource type="Script" path="res://data/scripts/npc_talk.gd" id="2_npc_talk"]
[ext_resource type="Script" path="res://data/scripts/npc_reaction.gd" id="3_npc_reaction"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("2_npc_talk")
scene = &"ch1_t_street_flyer"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_npc_talk")
scene = &"ch1_t_street_flyer_revisit"
min_talks = 1

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_npc_talk")
scene = &"ch1_t_street_flyer_died"
min_deaths = 1

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("2_npc_talk")
scene = &"ch1_t_street_flyer_open"
requires_flag = &"ch1_street_route_open"

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("3_npc_reaction")
gesture = &"greet"
max_talks = 0

[sub_resource type="Resource" id="Resource_5"]
script = ExtResource("3_npc_reaction")
gesture = &"nod"
min_talks = 1

[sub_resource type="Resource" id="Resource_6"]
script = ExtResource("3_npc_reaction")
gesture = &"hand_wring"
min_deaths = 1

[resource]
script = ExtResource("1_npc_data")
id = &"ch1_street_flyer"
display_name = "發傳單的人"
speaker = "flyer"
rig_id = "resident"
loop = &"hold_child"
facing = 1
prompt = "{interact} 和發傳單的人說話"
localized_prompts = Dictionary[String, String]({"en": "{interact} Talk to the flyer distributor", "ja": "{interact} ビラ配りと話す"})
talks = Array[ExtResource("2_npc_talk")]([SubResource("Resource_0"), SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3")])
reactions = Array[ExtResource("3_npc_reaction")]([SubResource("Resource_4"), SubResource("Resource_5"), SubResource("Resource_6")])

[gd_resource type="Resource" script_class="NpcData" load_steps=7 format=3]

[ext_resource type="Script" path="res://data/scripts/npc_data.gd" id="1_npc"]
[ext_resource type="Script" path="res://data/scripts/npc_talk.gd" id="2_talk"]

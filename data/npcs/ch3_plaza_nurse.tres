[gd_resource type="Resource" script_class="NpcData" load_steps=5 format=3]

[ext_resource type="Script" path="res://data/scripts/npc_data.gd" id="1_npc_data"]
[ext_resource type="Script" path="res://data/scripts/npc_talk.gd" id="2_npc_talk"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("2_npc_talk")
scene = &"ch3_dispatch_plaza_nurse"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_npc_talk")
scene = &"ch3_dispatch_plaza_nurse_again"
min_talks = 1

[resource]
script = ExtResource("1_npc_data")
id = &"ch3_plaza_nurse"
display_name = "早班護理員"
speaker = "shift_nurse"
rig_id = "nurse"
loop = &"glance"
facing = -1
prompt = "{interact} 和早班護理員說話"
localized_prompts = Dictionary[String, String]({"en": "{interact} Talk to the morning-shift nurse", "ja": "{interact} 早番の看護師と話す"})
talks = Array[ExtResource("2_npc_talk")]([SubResource("Resource_0"), SubResource("Resource_1")])

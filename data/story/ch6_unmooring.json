  "ch6_t_control_decision": {
   "mode": "animated",
   "steps": [
    {
     "do": "scene",
     "id": "ch6_lamp_control_room",
     "props": {
      "relay_dim": {
       "visible": false
      },
      "relay_active": {
       "visible": true
      },
      "noisy_display": {
       "visible": false
      },
      "clear_display": {
       "visible": true
      },
      "call_alarm": {
       "visible": true
      }
     },
     "fade": 0.15
    },
    {
     "do": "say",
     "speaker": "ali",
     "text": "有人等在我家外面。我想請凜過來，你能找到她嗎？",
     "ja": "家の外で誰かが待ってる。凜に来てほしい。連絡できる？",
     "en": "Someone's waiting outside my place. I want Rin to come over. Can you reach her?"
    },
    {
     "do": "say",
     "speaker": "lamp",
     "text": "只有一條臨時線。把電話接給凜，就得暫停蘇那邊的監聽。",
     "ja": "仮の回線は一本だけだ。凜に電話をつなぐなら、蘇の監聴をいったん止める。",
     "en": "There's one temporary line. Forwarding the call to Rin pauses Wake's monitor feed."
    },
    {
     "do": "choice",
     "text": "只有一條臨時線。把電話接給凜，就得暫停蘇那邊的監聽。",
     "default": "leave",
     "options": [
      {
       "id": "forward",
       "text": "把電話轉給凜",
       "explanation": "暫停監聽，讓凜直接收到來電。",
       "target": "ch6_t_relay_ali_call",
       "ja": "凜に電話をつなぐ",
       "en": "Forward the call to Rin",
       "explanation_ja": "監聴を止めて、凜に直接電話をつなぐ。",
       "explanation_en": "Pause monitoring and let Rin receive the call."
      },
      {
       "id": "keep",
       "text": "守住監聽線",
       "explanation": "讓蘇接著試音。這通電話不會轉接。",
       "target": "ch6_t_keep_relay_feed",
       "ja": "監聴回線を維持する",
       "en": "Keep the monitor line",
       "explanation_ja": "蘇はテストを続ける。この電話は転送しない。",
       "explanation_en": "Wake keeps testing the mic. The call stays here."
      },
      {
       "id": "leave",
       "text": "暫不做決定",
       "explanation": "保持來電與監聽的目前狀態。",
       "ja": "判断を保留する",
       "en": "Leave the decision open",
       "explanation_ja": "来電と監聴を現在の状態に保つ。",
       "explanation_en": "Keep the call and monitoring as they are."
      },
      {
       "id": "review",
       "text": "回去查線路",
       "explanation": "回錄音室，再開終端查看回訊。",
       "ja": "回線を確認し直す",
       "en": "Review the line",
       "explanation_ja": "録音室に戻り、端末を開き直して応答を確認する。",
       "explanation_en": "Return to the booth and reopen the terminal to inspect the line."
      }
     ],
     "cancel_choice_on_back": true,
     "ja": "仮の回線は一本だけだ。凜に電話をつなぐなら、蘇の監聴をいったん止める。",
     "en": "There's one temporary line. Forwarding the call to Rin pauses Wake's monitor feed."
    }
   ],
   "pose_policy": "supported",
   "when": {

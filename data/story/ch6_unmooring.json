  "ch6_t_offer_approach": {
   "mode": "animated",
   "steps": [
    {
     "do": "say",
     "speaker": "su",
     "text": "我是蘇，負責這裡的播報。妳到橋頭等白燈亮，我請人把高架放下來。",
     "ja": "蘇よ。ここの放送を担当してる。橋のたもとで白い灯が点くまで待って。高架を下ろしてもらう。",
     "en": "I'm Wake. I handle the broadcasts here. Wait for the white light at the bridgehead. I'll have them lower the overpass."
    },
    {
     "do": "say",
     "speaker": "rin",
     "text": "原帳在我這裡。到前庭再核對哪些能播。從貨梯過去嗎？",
     "ja": "原本は私が持ってる。何を放送できるか前庭で確認しよう。荷物用リフトから渡るの？",
     "en": "I have the original. We'll agree on what can be aired at the yard. Is the freight lift the way across?"
    },
    {
     "do": "choice",
     "text": "原帳在我這裡。到前庭再核對哪些能播。從貨梯過去嗎？",
     "default": "leave",
     "options": [
      {
       "id": "follow",
       "text": "從貨梯上高架。",
       "explanation": "打開廣場的維修貨梯。",
       "target": "ch6_t_confirm_approach",
       "ja": "荷物用リフトで高架に上る。",
       "en": "Take the freight lift to the overpass.",
       "explanation_ja": "広場の保守用リフトを開ける。",
       "explanation_en": "Open the plaza's service lift."
      },
      {
       "id": "leave",
       "text": "先留在廣場。",
       "explanation": "稍後可以再接入喇叭。",
       "ja": "今は広場に残る。",
       "en": "Stay in the plaza for now.",
       "explanation_ja": "あとでスピーカーに戻れる。",
       "explanation_en": "You can come back to the speaker."
      }
     ],
     "cancel_choice_on_back": true,
     "ja": "原本は私が持ってる。何を放送できるか前庭で確認しよう。荷物用リフトから渡るの？",
     "en": "I have the original. We'll agree on what can be aired at the yard. Is the freight lift the way across?"

    }
   ]
  },
  "ch1_g10_disk": {
   "mode": "radio",
   "lines": [
    {
     "speaker": "lamp",
     "text": "資料盤記著收帳人的帳，天穹為什麼要查這個？"
    },
    {
     "speaker": "rin",
     "text": "我不知道來路，錢到了就行。"
    }
   ]
  },

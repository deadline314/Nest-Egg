  "ch1_b_roof": {
   "mode": "bubbles",
   "lines": [
    {
     "speaker": "egret",
     "text": "小鬼。遲到三分鐘。"
    },
    {
     "speaker": "rin",
     "text": "老 K 在吃飯。"
    },
    {
     "speaker": "egret",
     "text": "那老頭永遠在吃飯。"
    }
   ]
  },
  "ch1_t_egret_1": {
   "mode": "dialogue",
   "set_flags": [
    "ch1_heard_brief"
   ],
   "lines": [
    {
     "speaker": "egret",
     "text": "地點，碼頭倉庫。目標，保險箱裡一片資料盤。"
    },
    {
     "speaker": "egret",
     "text": "有隻看門狗守著。兩條腿，一條尾巴，脾氣不好。"
    },
    {
     "speaker": "rin",
     "text": "誰要的。"
    },
    {
     "speaker": "egret",
     "text": "上面。我不問，你也別問。"
    },
    {
     "speaker": "rin",
     "text": "你呢。"
    },
    {
     "speaker": "egret",
     "text": "我今晚有事。…看一個人。"
    },
    {
     "speaker": "egret",
     "text": "你一個人去。不要一個人死，浪費。開玩笑啦。"
    },
    {
     "speaker": "egret",
     "text": "看到那座塔沒有？上面有太陽。真的太陽。"
    }
   ]
  },
  "ch1_t_egret_2": {
   "mode": "dialogue",
   "lines": [
    {
     "speaker": "egret",
     "text": "欸，晴岸？你要買房？"
    },
    {
     "speaker": "rin",
     "text": "還早。"
    },
    {
     "speaker": "egret",
     "text": "給誰？"
    },
    {
     "speaker": "rin",
     "text": "一個人。"
    },
    {
     "speaker": "egret",
     "text": "喔——老頭子的喔？"
    },
    {
     "speaker": "rin",
     "text": "別說。"
    },
    {
     "speaker": "egret",
     "text": "好好好。嘴巴縫起來。你要帶他去喔。"
    }
   ]
  },
  "ch1_b_street_in": {
   "mode": "bubbles",
   "lines": [
    {
     "speaker": "rin",
     "text": "老 K 每次都問：帶傘了嗎。"
    },
    {
     "speaker": "rin",
     "text": "下面本來就是水。"
    }
   ]
  },

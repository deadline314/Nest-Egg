  "ch1_b_dinner": {
   "mode": "bubbles",
   "set_flags": [
    "ch1_dinner_done"
   ],
   "lines": [
    {
     "speaker": "old_k",
     "text": "今天的飯煮好了喔。"
    },
    {
     "speaker": "rin",
     "text": "這是今天的四十信用點。"
    },
    {
     "speaker": "old_k",
     "text": "我把紅蘿蔔切很細了啊。"
    },
    {
     "speaker": "rin",
     "text": "還是看得到。"
    }
   ]
  },
  "ch1_t_oldk_1": {
   "mode": "dialogue",
   "lines": [
    {
     "speaker": "old_k",
     "text": "這個月接了幾次差事？"
    },
    {
     "speaker": "rin",
     "text": "已經接了九次。"
    },
    {
     "speaker": "old_k",
     "text": "你接得太多了喔。"
    },
    {
     "speaker": "rin",
     "text": "別人接得比我多，我還行。"
    },
    {
     "speaker": "old_k",
     "text": "飯要涼了喔，先吃飯吧。"
    }
   ]
  },
  "ch1_t_oldk_2": {
   "mode": "dialogue",
   "lines": [
    {
     "speaker": "old_k",
     "text": "記得回來吃飯。"
    },
    {
     "speaker": "rin",
     "text": "我會記得回來。"
    },
    {
     "speaker": "old_k",
     "text": "外面的水又漲了，路上小心喔。"
    }
   ]
  },
  "ch1_t_oldk_d1": {
   "mode": "dialogue",
   "lines": [
    {
     "speaker": "old_k",
     "text": "…又死了？"
    },
    {
     "speaker": "rin",
     "text": "剛才又倒了一次。"
    },
    {
     "speaker": "old_k",
     "text": "水燒好了。吃完再去。"
    }
   ]
  },
  "ch1_t_oldk_d4": {
   "mode": "dialogue",
   "lines": [
    {
     "speaker": "old_k",
     "text": "這個月第幾次了？"
    },
    {
     "speaker": "rin",
     "text": "別再替我數了。"
    },
    {
     "speaker": "old_k",
     "text": "你不肯數，我就替你記著喔。"
    }
   ]
  },
  "ch1_b_roof": {
   "mode": "bubbles",
   "lines": [
    {
     "speaker": "egret",
     "text": "小鬼，你遲到三分鐘了。"
    },
    {
     "speaker": "rin",
     "text": "老 K 在吃飯。"
    },
    {
     "speaker": "egret",
     "text": "那老頭永遠在吃飯。"
    }
   ]
  },
  "ch1_t_egret_1": {
   "mode": "dialogue",
   "set_flags": [
    "ch1_heard_brief"
   ],
   "lines": [
    {
     "speaker": "egret",
     "text": "這次要去碼頭倉庫，拿回保險箱裡存著帳目的資料盤。"
    },
    {
     "speaker": "egret",
     "text": "看門狗是倉庫的保全機甲，牠的脾氣可不好。"
    },
    {
     "speaker": "rin",
     "text": "是誰委託的？"
    },
    {
     "speaker": "egret",
     "text": "是天穹那邊要的，我沒追問來路，你也別問。"
    },
    {
     "speaker": "rin",
     "text": "你不跟我去？"
    },
    {
     "speaker": "egret",
     "text": "我今晚要去看一個人，下次再跟你說。"
    },
    {
     "speaker": "egret",
     "text": "你可別一個人死，連陪你喝酒的人都沒有。"
    },
    {
     "speaker": "egret",
     "text": "看到那座塔沒有？塔頂能看到真的太陽。"
    }
   ]
  },
  "ch1_t_egret_2": {
   "mode": "dialogue",
   "lines": [
    {
     "speaker": "egret",
     "text": "晴岸是日照區的住宅，你想在那裡買房？"
    },
    {
     "speaker": "rin",
     "text": "離買得起還早。"
    },
    {
     "speaker": "egret",
     "text": "你想給誰住？"
    },
    {
     "speaker": "rin",
     "text": "給家裡那個人住。"
    },
    {
     "speaker": "egret",
     "text": "你想讓老頭子住在那裡喔？"
    },
    {
     "speaker": "rin",
     "text": "別跟老 K 說。"
    },
    {
     "speaker": "egret",
     "text": "我會把嘴巴縫起來，你記得帶他去喔。"
    }
   ]
  },
  "ch1_b_street_in": {
   "mode": "bubbles",
   "lines": [
    {
     "speaker": "rin",
     "text": "老 K 每次都問：帶傘了嗎。"
    },
    {
     "speaker": "rin",
     "text": "下面本來就是水。"
    }
   ]
  },
  "ch1_g06_lamp": {
   "mode": "radio",
   "lines": [
    {
     "speaker": "lamp",
     "text": "我是幫你看路的燈，聽得到嗎？收帳人封了市集，改走碼頭那邊。"
    },
    {
     "speaker": "rin",
     "text": "聽得到。"
    }
   ]
  },

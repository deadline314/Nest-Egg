    }
   ]
  },
  "ch1_d_back_b": {
   "mode": "radio",
   "lines": [
    {
     "speaker": "lamp",
     "text": "再來一次，沒關係。"
    }
   ]
  },
  "ch1_d_back_c": {
   "mode": "radio",
   "lines": [
    {
     "speaker": "lamp",
     "text": "…歡迎回來。"
    }
   ]
  },
  "ch1_b_lounge": {
   "mode": "bubbles",
   "lines": [
    {
     "speaker": "ali",
     "text": "先坐下喝湯吧，湯還熱著。"
    }
   ]
  },
  "ch1_t_ali_1": {
   "mode": "dialogue",
   "set_flags": [
    "ch1_met_ali"
   ],
   "lines": [
    {
     "speaker": "ali",
     "text": "剛從電話亭醒來嗎？"
    },
    {
     "speaker": "rin",
     "text": "我剛從電話亭醒來。"
    },
    {
     "speaker": "ali",
     "text": "你還能自己走進來，運氣真好。復原餐是補身的熱湯，要吃餐還是喝酒？"
    },
    {
     "speaker": "rin",
     "text": "湯和酒我都要。"
    },
    {
     "speaker": "ali",
     "text": "您貴姓？"
    },
    {
     "speaker": "rin",
     "text": "我叫凜。"
    },
    {
     "speaker": "ali",
     "text": "我叫阿梨，名字取的是梨子的梨。別跟人分梨吃，老人說這樣會分開。"
    },
    {
     "speaker": "rin",
     "text": "我記住了。"
    }
   ]
  },
  "ch1_t_ali_2": {
   "mode": "dialogue",
   "lines": [
    {
     "speaker": "rin",
     "text": "這湯怎麼是甜的？"
    },
    {
     "speaker": "ali",
     "text": "放了一顆梨。"
    },
    {
     "speaker": "ali",
     "text": "我下班了。這個不是工作。"
    },
    {
     "speaker": "rin",
     "text": "這份要多少錢？"
    },
    {
     "speaker": "ali",
     "text": "放著吧。"
    }
   ]
  },
  "ch1_b_stall": {
   "mode": "bubbles",
   "lines": [
    {
     "speaker": "ali",
     "text": "先吃一碗熱麵吧。"
    }
   ]
  },
  "ch1_t_ali_4": {
   "mode": "dialogue",
   "lines": [
    {
     "speaker": "ali",
     "text": "吃完再走。"
    },
    {
     "speaker": "rin",
     "text": "我記住了。"
    },
    {
     "speaker": "ali",
     "text": "天快亮了。"
    }
   ]
  },
  "ch1_t_ali_3": {
   "mode": "dialogue",
   "set_flags": [
    "knows_ali_address"
   ],
   "lines": [
    {
     "speaker": "rin",
     "text": "這份要多少錢？"
    },
    {
     "speaker": "ali",
     "text": "不收錢。"
    },
    {
     "speaker": "rin",
     "text": "那我欠你。"
    },
    {
     "speaker": "ali",
     "text": "那就欠著。"
    },
    {
     "speaker": "ali",
     "text": "我最近被收帳人盯上了。"
    },
    {
     "speaker": "rin",
     "text": "他們要你還多少？"
    },

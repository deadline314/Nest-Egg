[ext_resource type="Resource" path="res://data/enemies/grunt.tres" id="3_grunt"]
[ext_resource type="Resource" path="res://data/consumables/med_injector.tres" id="4_med"]

[sub_resource type="Resource" id="Resource_east"]
script = ExtResource("2_portal")
id = &"a_east"
target_level = "res://tests/fixtures/areas/area_b.tres"

+## Default condition facts retain invalid separately from legitimate false/missing.
+## The root owns cache/failure; empty failure permits a legitimate null flag value.
+## No per-leaf result object; ledger proof is shared only within that synchronous call.
+func condition_fact(kind: StringName, id: StringName, cache: Dictionary, failure: Array[String]) -> Variant:
+	var key := String(id)
+	match kind:
+		&"flag":
+			if not GameState.flag_defaults.has(key) and not runtime_facts.has(key) and not derived_flags.has(key) and not _condition_producers.has(key):
+				failure[0] = "未登記的旗標：" + key
+				return null
+			if runtime_facts.has(key):
+				var provider: Variant = runtime_facts[key]
+				if not (provider is String or provider is StringName):
+					failure[0] = "runtime_facts.%s 提供者型別無效" % key
+					return null
+				var name := String(provider)
+				if name.begins_with("context:"):
+					var context_key := name.substr(8)
+					if context_key.is_empty() or (context_facts.has(context_key) and not context_facts[context_key] is bool):
+						failure[0] = "runtime_facts.%s 情境事實無效" % key
+						return null
+				elif not RUNTIME_PROVIDERS.has(name):
+					failure[0] = "runtime_facts.%s 未知提供者：%s" % [key, name]
+					return null
+			elif derived_flags.has(key) and not _condition_derived(key, cache, failure):
+				return null
+			return flag_value(id)
+		&"held":
+			if StoryItems.find(id) == null:
+				failure[0] = "未登記的道具：" + key
+				return null
+			return StoryItems.holds(id)
+		&"receipt", &"account":
+			if kind == &"account" and id != &"ch1_lounge":
+				failure[0] = "未登記的帳務投影：" + key
+				return null
+			var proof := _condition_ledger(cache)
+			if not proof["valid"]:
+				failure[0] = String(proof["error"])
+				return null
+			if kind == &"receipt":
+				if not cache["definitions"].has(key):
+					failure[0] = "未登記的收據：" + key
+					return null
+				return cache["ledger"]["receipts"].has(key)
+			return proof["account"]
+	failure[0] = "未知事實種類：" + String(kind)
+	return null
+
+
+## Validate provenance without replacing or writing the stored derived scalar.
+func _condition_derived(key: String, cache: Dictionary, failure: Array[String]) -> bool:
+	if not cache.has("derived_checked"):
+		cache["derived_checked"] = {}
+		cache["derived_visiting"] = {}
+	var checked: Dictionary = cache["derived_checked"]
+	var visiting: Dictionary = cache["derived_visiting"]
+	if checked.has(key):
+		return true
+	if visiting.has(key):
+		failure[0] = "derived_flags.%s: 派生來源循環" % key
+		return false
+	visiting[key] = true
+	var source: Variant = derived_flags[key]
+	var problem := StoryRules._condition_problem(source, int(cache["depth"]) + 1, cache["schema_budget"])
+	if not problem.is_empty():
+		failure[0] = problem
+	else:
+		StoryRules._holds_valid(source, Callable(), cache, failure)
+	visiting.erase(key)
+	if not failure[0].is_empty():
+		failure[0] = "derived_flags." + key + failure[0]
+		return false
+	checked[key] = true
+	return true
+
+
+func _condition_ledger(cache: Dictionary) -> Dictionary:
+	if cache.has("ledger_proof"):
+		return cache["ledger_proof"]
+	if not _condition_catalog_loaded:
+		_condition_catalog_loaded = true
+		var count := 0
+		for file in DirAccess.get_files_at("res://data/story_transactions"):
+			if file.trim_suffix(".remap").ends_with(".tres"):
+				count += 1
+		if count <= StoryConditionTree.MAX_FACTS:
+			for resource: StoryTransactionData in ResourceCatalog.load_dir("res://data/story_transactions", StoryTransactionData, "StoryConditions"):
+				_condition_resources.append(resource)
+		if count == 0 or count > StoryConditionTree.MAX_FACTS or _condition_resources.size() != count:
+			_condition_catalog_error = "res://data/story_transactions 的正式資源缺漏、重複或型別無效"
+	var definitions := {}
+	var error := _condition_catalog_error
+	if error.is_empty():
+		for resource in _condition_resources:
+			var descriptor := resource.descriptor()
+			if descriptor.has("error") or definitions.has(String(resource.id)):
+				error = resource.resource_path + ": " + str(descriptor.get("error", "重複交易 ID"))
+				break
+			definitions[String(resource.id)] = descriptor
+	cache["definitions"] = definitions
+	if not error.is_empty():
+		cache["ledger_proof"] = {"valid": false, "error": error}
+	else:
+		cache["ledger"] = Progression._story_transactions.snapshot()
+		cache["ledger_proof"] = StoryConditionTree.verify_ledger({"ledger": cache["ledger"]}, {"ledger_locked": Progression._story_transactions._locked, "transaction_definitions": definitions})
+	return cache["ledger_proof"]
+
+
+## Bounded owner-local report-once cache, reset with loaded chapter tables.
+func report_condition(problem: String) -> void:
+	problem = problem.left(512)
+	if _condition_reports.has(problem):
+		return
+	if _condition_reports.size() >= StoryConditionTree.MAX_FACTS:
+		return
+	_condition_reports[problem] = true
+	push_error("[StoryRules] " + problem)
+

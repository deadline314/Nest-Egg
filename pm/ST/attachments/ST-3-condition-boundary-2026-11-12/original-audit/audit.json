  "schema_differences": [
    {
      "topic": "legacy外層",
      "runtime": "eligible: requires_flag/unless_flag/requires_item(取得史) + requires_held/unless_held/requires_transferred；ID先str→StringName；flag_reader使用八種scalar truth",
      "strict": "不是when tree schema，strict evaluate拒絕requires_item這類op",
      "guard": "不要把legacy外層欄位直接當strict when或改其owns/held語義"
    },
    {
      "topic": "when形狀",
      "runtime": "空物件true；all/any/not/flag/item/receipt/account；同時多op/額外key依分支先後接受；沒有budget",
      "strict": "exact keys；深16/節點256/children32；ID<=64、String<=256、finite scalar<=999999999",
      "guard": "共享結構驗證可修未知op/形狀/bounds；需保留合法API相容與全分支invalid傳遞"
    },
    {
      "topic": "flag葉",
      "runtime": "equals可省略預設true；same_value null可等false/空字串/0/unset；int/float數值比；String/StringName按str",
      "strict": "equals必需；宣告facts存在才合法；數值可相等但bool不與數字混同；StringName非strict scalar",
      "guard": "正式三章沒有缺equals，API相容仍應明示；不得把未知事實任意補false再在not下放行"
    },
    {
      "topic": "布林樹",
      "runtime": "短路；invalid與false混為bool；not({unknown:true})會成true",
      "strict": "validate+evaluate valid/value/error；每支走完驗事實；invalid不被not或其他分支蓋掉",
      "guard": "schema-only gate不等於完整值級ledger/facts接線"
    },
    {
      "topic": "receipt/account",
      "runtime": "reader回bool/String；account_state忽略account參數；false/status投影不能獨立區分未存在與壞/locked",
      "strict": "receipt葉僅第一章7ID；account僅ch1_lounge與合法6子集；ledger需locked、當前descriptor指紋/delta/依賴證明；descriptor表可包含後章交易",
      "guard": "不能只拿live ledger覆蓋proposed candidate。現行正式三章receipt葉只用ch1 IDs，不代表API永遠只有七種"
    },
    {
      "topic": "候選快照",
      "runtime": "run_flag_commit29/35、StoryFlagCompletion151、StoryResultCompletion420/421以Callable讀候選flags/held/ledger",
      "strict": "evaluate需顯式facts/context投影",
      "guard": "新adapter必須保留reader候選語義、runtime/context已宣告預設，不要無條件回live服務"
    }
  ],

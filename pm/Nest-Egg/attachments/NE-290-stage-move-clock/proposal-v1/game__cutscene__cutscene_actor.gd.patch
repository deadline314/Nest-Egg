 func _process(delta: float) -> void:
+	if _stage_move_active:
+		_stage_move_render_credit = 0.0
+		return
+	var credit := _stage_move_render_credit
+	var step_delta := maxf(0.0, delta - credit)
+	_stage_move_render_credit = 0.0
+	if step_delta > 0.0 or credit == 0.0:
+		_advance_stage_actor(step_delta)
+
+
+func _advance_stage_actor(delta: float) -> void:
 	_t += delta
 	if _settling:
 		var progress := (rig.animator as NpcAnimator).posture_progress() if rig != null and rig.animator is NpcAnimator else 1.0
@@ -267,3 +285,58 @@
 		&"jump":
 			_input.on_floor = false
 			_input.velocity = Vector2(60.0 * facing, -120.0)

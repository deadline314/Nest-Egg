+func _finish_swing(player: Player) -> void:
+	var ticks := 240
+	while player._melee_phase != Player.MeleePhase.NONE and ticks > 0:
+		await physics_frames(1)
+		ticks -= 1
+	check(ticks > 0, "the actual melee action finishes within four seconds")

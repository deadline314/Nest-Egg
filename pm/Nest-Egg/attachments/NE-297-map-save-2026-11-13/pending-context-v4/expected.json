      ],
      "source_id": "npc:ch1_egret@54,17",
      "context": {
        "framing_source": "person",
        "source_id": "npc:ch1_egret@54,17",
        "talk_index": 0
      },
      "lines": [
        {
          "step_index": 4,
          "where": "場景 ch1_t_egret_1 第 4 步（say）",
          "speaker": "egret",
          "name": "鷺",
          "text": "倉庫保險箱裡有一片資料盤，今晚把它取出來。驗收是八百，不是看一眼就算。"
        },
        {
          "step_index": 5,
          "where": "場景 ch1_t_egret_1 第 5 步（say）",
          "speaker": "rin",
          "name": "凜",
          "text": "一成照舊，先別算進我能花的錢。"
        },
        {
          "step_index": 6,
          "where": "場景 ch1_t_egret_1 第 6 步（say）",
          "speaker": "egret",
          "name": "鷺",
          "text": "看門狗是倉庫的保全機甲，牠的脾氣可不好。天穹委託的盤，你先照編號取。"
        },
        {
          "step_index": 8,
          "where": "場景 ch1_t_egret_1 第 8 步（say）",
          "speaker": "egret",
          "name": "鷺",
          "text": "拿到盤後走倉庫上層出口。那條路到復原館外的交接櫃，不用帶著盤再穿一次路障。"
        },
        {
          "step_index": 9,
          "where": "場景 ch1_t_egret_1 第 9 步（say）",
          "speaker": "rin",
          "name": "凜",
          "text": "復原館就是電話亭旁邊那間夜間店？"
        },
        {
          "step_index": 10,
          "where": "場景 ch1_t_egret_1 第 10 步（say）",
          "speaker": "egret",
          "name": "鷺",
          "text": "對，交接櫃在店外，不是交給店裡的人。櫃子收盤後吐回執，明早我跟你對錢。"
        },
        {
          "step_index": 12,
          "where": "場景 ch1_t_egret_1 第 12 步（say）",
          "speaker": "rin",
          "name": "凜",
          "text": "盤放進櫃子裡，回執由我自己收著，我記住了。"
        }
      ],

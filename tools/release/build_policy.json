  "directory_loads": [
    {"source": "game/cutscene/stage_library.gd", "root": "data/cutscene/stages"},
    {"source": "core/navigation/quest_map_index.gd", "root": "data/levels"},
    {"source": "core/prop_library.gd", "root": "data/environment/props"},
    {"source": "autoload/story_items.gd", "root": "data/story_items"},
    {"source": "game/player/consumable_bag.gd", "root": "data/consumables"},
    {"source": "core/weapon_catalog.gd", "root": "data/weapons"},
    {"source": "core/weapon_catalog.gd", "root": "data/upgrades"},
    {"source": "autoload/progression.gd", "root": "data/abilities"},
    {"source": "autoload/progression.gd", "root": "data/story_transactions"}
  ]

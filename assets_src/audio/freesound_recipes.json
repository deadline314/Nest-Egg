{
 "_說明": "Freesound CC0 素材配方，tools/audio/add_freesound.py 讀這份挑音效。match／exclude 比對標題（不分大小寫的正規表示式）；min_dur／max_dur 秒；max 每包上限。",
 "packs": [
  {"id": "fs_cc0-gunshots-pistol", "title": "Freesound CC0：手槍與左輪槍聲", "notes": "手槍、左輪、沙漠之鷹等單發槍聲",
   "queries": ["pistol shot", "handgun shot", "9mm", "revolver shot", "pistol gunshot", "desert eagle", "glock"],
   "match": "pistol|handgun|9mm|magnum|revolver|desert eagle|glock|colt|beretta|1911|\\.45|\\.22|\\.38|\\.357",
   "exclude": "load|cock|spin|chamber|clip|magazine|silenc|suppress|loop|dry|click|stun|toy|nerf|airsoft|cap gun|water|8-bit|laser|empty|draw|holster",
   "min_dur": 0.15, "max_dur": 8, "min_downloads": 100, "max": 30},
  {"id": "fs_cc0-gunshots-rifle", "title": "Freesound CC0：步槍與狙擊槍聲", "notes": "突擊步槍、栓動步槍、狙擊槍的單發或短連發",
   "queries": ["rifle shot", "assault rifle", "sniper rifle shot", "ak-47 shot", "m4 rifle", "ar-15", "rifle gunshot", "bolt action rifle"],
   "match": "rifle|sniper|ak-?47|\\bm4\\b|ar-?15|carbine|mosin|\\bm16\\b|g36|scar|kalashnikov|musket",
   "exclude": "reload|cock|clip|magazine|scope|zoom|loop|dry|click|toy|airsoft|empty|laser|scifi|sci-fi|pulse|bolt (open|close)|equip|slide",
   "min_dur": 0.15, "max_dur": 14, "min_downloads": 80, "max": 30},
  {"id": "fs_cc0-gunshots-shotgun", "title": "Freesound CC0：霰彈槍聲", "notes": "霰彈槍單發與連發",
   "queries": ["shotgun", "shotgun blast", "pump shotgun", "shotgun shot", "12 gauge"],
   "match": "shotgun|12.?gauge|\\bsg\\b",
   "exclude": "reload|cock|clip|loop|dry|click|toy|nerf|airsoft|empty|laser|rack|shell|explosion|bomb|pump|ready|hit|clink",
   "min_dur": 0.15, "max_dur": 12, "min_downloads": 80, "max": 25},
  {"id": "fs_cc0-gunshots-automatic", "title": "Freesound CC0：衝鋒槍與機槍聲", "notes": "衝鋒槍、機槍的連發與單發",
   "queries": ["machine gun", "submachine gun", "smg", "uzi", "machine gun burst", "automatic gun", "minigun", "light machine gun", "gun burst"],
   "match": "machine ?gun|smg|uzi|submachine|burst|automatic|minigun|mp5|mp40|tommy|thompson|lmg|full auto",
   "exclude": "reload|cock|clip|magazine|dry|click|toy|nerf|airsoft|empty|laser|8-bit|battle|war|firefight|ambience|crowd|battlefield|football|firework|engine|mx5|car",
   "min_dur": 0.2, "max_dur": 20, "min_downloads": 80, "max": 30},
  {"id": "fs_cc0-gunshots-silenced", "title": "Freesound CC0：消音槍聲", "notes": "消音手槍與步槍",
   "queries": ["silenced pistol", "suppressed gun", "silencer", "suppressed shot", "silenced shot", "silenced rifle"],
   "match": "silenc|suppress",
   "exclude": "reload|cock|clip|dry|click|toy|nerf|airsoft|empty|laser|8-bit",
   "min_dur": 0.1, "max_dur": 10, "min_downloads": 20, "max": 20},
  {"id": "fs_cc0-gunshots-generic", "title": "Freesound CC0：各式槍聲", "notes": "不分槍種的槍聲，敵人通用槍聲備選",
   "queries": ["gunshot", "gun shot", "gunshot single", "gun fire", "gunshot echo", "gunshots"],
   "match": "gun ?shot|gun ?fire|gun ?blast|shoot|bang",
   "exclude": "reload|cock|clip|magazine|dry|click|toy|nerf|airsoft|empty|laser|8-bit|music|beat|remix|song|loop|ambience|crowd|cannon|rocket|photo|camera|screenshot|mic|snap|shotgun|silenc|suppress|slap|punch|hit|door|knock|balloon",
   "min_dur": 0.15, "max_dur": 8, "min_downloads": 100, "max": 30},
  {"id": "fs_cc0-gunshots-heavy", "title": "Freesound CC0：重武器與砲聲", "notes": "加農砲、火箭筒、榴彈發射器、重砲",
   "queries": ["cannon shot", "rocket launcher", "grenade launcher", "rpg launch", "bazooka", "artillery", "cannon fire", "mortar", "tank shot"],
   "match": "cannon|rocket|grenade|rpg|bazooka|artillery|mortar|tank|launcher|howitzer",

   "queries": ["gun reload", "pistol reload", "rifle reload", "shotgun pump", "gun cocking", "revolver cock", "magazine insert", "bolt action", "dry fire", "gun click", "slide rack", "ak-47 reload", "shotgun reload"],
   "match": "reload|cock|rack|pump|magazine|clip|bolt|slide|dry|chamber|spin|cylinder|charging|safety|holster",
   "exclude": "toy|nerf|airsoft|8-bit|laser|water|camera|mouse|keyboard|pen|lighter|stapler|door|music|loop|ambience|gunshot|firing|fired",
